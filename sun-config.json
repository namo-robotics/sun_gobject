{
  "root": true,
  "sun_fmt": {
    "ignore": [
      "src/generated/**",
      "build/**",
      ".sun/**",
      "tests/fixtures/**"
    ]
  },
  "path_variables": {
    "SUN_GOBJECT_BUILD": "build"
  },
  "entrypoints": [
    {
      "name": "sun_gobject",
      "path": "src/sun_gobject.sun",
      "type": "library",
      "export": true,
      "build": [
        "scripts/build-configured-library.sh"
      ]
    },
    {
      "name": "sun_gtk",
      "path": "src/sun_gtk.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_gobject"
      ],
      "steps": [
        "native"
      ],
      "resources": [
        {
          "path": "${SUN_BUILD}/native/libsun_gobject_native.a",
          "destination": "native/libsun_gobject_native.a"
        }
      ]
    },
    {
      "name": "sun_capture",
      "path": "src/sun_capture.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_gobject"
      ],
      "steps": [
        "native"
      ],
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "resources": [
        {
          "path": "${SUN_BUILD}/native/libsun_capture_native.a",
          "destination": "native/libsun_capture_native.a"
        }
      ]
    },
    {
      "name": "sun_gir",
      "path": "src/generator/main.sun",
      "type": "binary"
    },
    {
      "name": "sun_gobject_tests",
      "path": "tests/main.sun",
      "type": "binary"
    },
    {
      "name": "release_package_tool",
      "path": "tools/package.sun",
      "type": "binary"
    }
  ],
  "package_id": "namo-robotics/sun_gobject",
  "steps": [
    {
      "name": "native_configure",
      "command": [
        "cmake",
        "-S",
        "src/native",
        "-B",
        "${SUN_BUILD}/native",
        "-DBUILD_TESTING=OFF"
      ],
      "inputs": [
        "src/native/CMakeLists.txt"
      ],
      "outputs": [
        "${SUN_BUILD}/native/CMakeCache.txt"
      ]
    },
    {
      "name": "native",
      "requires": [
        "native_configure"
      ],
      "command": [
        "cmake",
        "--build",
        "${SUN_BUILD}/native",
        "-j",
        "${SUN_JOBS}"
      ],
      "inputs": [
        "src/native"
      ],
      "outputs": [
        "${SUN_BUILD}/native/libsun_gobject_native.a"
      ]
    }
  ],
  "exports": [
    {
      "path": "LICENSE",
      "destination": "share/sun_gobject/LICENSE"
    }
  ],
  "packages": [
    {
      "name": "sun_gobject",
      "entrypoints": [
        "sun_gobject",
        "sun_gtk",
        "sun_capture"
      ],
      "resources": [
        {
          "path": "${SUN_BUILD}/native/native-versions.txt",
          "destination": "share/sun_gobject/native-versions.txt"
        },
        {
          "path": "${SUN_BUILD}/generated/provenance.json",
          "destination": "share/sun_gobject/provenance.json"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "type": "system",
      "check": {
        "type": "executable",
        "name": "cmake"
      },
      "target": {
        "linux": {
          "apt": [
            "cmake"
          ]
        },
        "macos": {
          "brew": [
            "cmake"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "executable",
        "name": "pkg-config"
      },
      "target": {
        "linux": {
          "apt": [
            "pkg-config"
          ]
        },
        "macos": {
          "brew": [
            "pkgconf"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gtk4"
      },
      "target": {
        "linux": {
          "apt": [
            "libgtk-4-dev"
          ]
        },
        "macos": {
          "brew": [
            "gtk4"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gio-2.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libglib2.0-dev"
          ]
        },
        "macos": {
          "brew": [
            "glib"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gobject-2.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libglib2.0-dev"
          ]
        },
        "macos": {
          "brew": [
            "glib"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "glib-2.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libglib2.0-dev"
          ]
        },
        "macos": {
          "brew": [
            "glib"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gio-unix-2.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libglib2.0-dev"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gstreamer-1.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libgstreamer1.0-dev"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "gstreamer-video-1.0"
      },
      "target": {
        "linux": {
          "apt": [
            "libgstreamer-plugins-base1.0-dev"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "x11"
      },
      "target": {
        "linux": {
          "apt": [
            "libx11-dev"
          ]
        }
      }
    },
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "name": "xext"
      },
      "target": {
        "linux": {
          "apt": [
            "libxext-dev"
          ]
        }
      }
    }
  ]
}
