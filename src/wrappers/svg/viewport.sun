using std;

/** Provides one owned binding type within the shared module. */
public module svg {

  /** Describes a native librsvg viewport; rendering requires valid borrowed native handles. */
  public class Viewport {
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    var width: f64;
    var height: f64;

    /** Records the requested output dimensions, validated when rendering. */
    init(width: f64, height: f64) {
      this.width = width;
      this.height = height;
    }

    /** Renders live borrowed handles; callers guarantee their native types and lifetimes. */
    public unsafe method render(document: raw_ptr<u8>, cairo: raw_ptr<u8>) bool {
      if (this.width <= 0.0 or this.height <= 0.0 or this.width > F64_MAX or this.height > F64_MAX or
        this.width != this.width or this.height != this.height) {
        return false;
      }
      return unsafe { rsvg_handle_render_document(document, cairo, this, null); } != 0;
    }
  }
}
