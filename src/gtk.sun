using std;
/** Owns GTK objects and delivers button events without exposing callback pointers. */
public module gtk {
  /** Stops execution before a GTK operation on a non-main thread. */
  extern "C" function sg_ui_require_main_thread() void;

  /** Validates UTF-8 and rejects embedded NUL bytes before calling GTK. */
  extern "C" function sg_ui_valid_text(text: raw_ptr<u8>, length: u64) i32;

  /** Creates an independent native click queue retaining its button. */
  extern "C" function sg_button_events_new(button: raw_ptr<u8>) raw_ptr<u8>;

  /** Disconnects and releases a click queue and its button reference. */
  extern "C" function sg_button_events_free(events: raw_ptr<u8>) void;

  /** Consumes one queued click. */
  extern "C" function sg_button_events_take(events: raw_ptr<u8>) i32;

  /** Emits a concrete clicked signal without exposing variadic calls. */
  extern "C" function sg_button_emit_clicked(button: raw_ptr<u8>) void;

  /** Checks whether GTK has detached a destroyed window from its application. */
  extern "C" function sg_window_is_open(window: raw_ptr<u8>) i32;

  /** Rejects manual context pumping while a callback loop is active. */
  extern "C" function sg_ui_require_manual_iteration() void;

  /** Initializes GTK while allowing an unavailable display to be reported. */
  extern "C" function gtk_init_check() i32;

  /** Checks the application identifier syntax before construction. */
  extern "C" function g_application_id_is_valid(id: raw_ptr<u8>) i32;

  /** Registers an application and runs its startup handlers. */
  extern "C" function g_application_register(app: raw_ptr<u8>, cancellable: raw_ptr<u8>, error: raw_ptr<u8>) i32;

  /** Reads a widget's parent without transferring ownership. */
  extern "C" function gtk_widget_get_parent(widget: raw_ptr<u8>) raw_ptr<u8>;

  /** Enforces GTK's main-thread boundary, including during object destruction. */
  function require_thread() void {
    unsafe { sg_ui_require_main_thread(); };
  }

  /** Validates text before it crosses the C string boundary. */
  function validate(text: ref String) SystemResult<void> {
    if (unsafe { sg_ui_valid_text(text.c_str(), _convert<u64>(text.length())); } == 0) {
      return SystemResult.Error(Error(1, "GTK text must be UTF-8 without embedded NUL bytes"));
    }
    return SystemResult.Ok;
  }

  /** Owns a registered, non-unique GTK application on the main thread. */
  public class Application {
    var pointer: raw_ptr<u8> = null;
    var stopped: bool = false;
    /** Initializes GTK and registers a valid application, or reports failure. */
    init(id: ref String) SystemResult<void> {
      require_thread();
      try validate(id);
      if (unsafe { g_application_id_is_valid(id.c_str()); } == 0) {
        return SystemResult.Error(Error(1, "Invalid application identifier"));
      }
      if (unsafe { gtk_init_check(); } == 0) {
        return SystemResult.Error(Error(1, "Cannot initialize the GTK display"));
      }
      this.pointer = unsafe { raw.gtk_application_new(id.c_str(), 32); };
      if (unsafe { g_application_register(this.pointer, null, null); } == 0) {
        unsafe { gobject.raw.g_object_unref(this.pointer); };
        this.pointer = null;
        return SystemResult.Error(Error(1, "Cannot register GTK application"));
      }
    }

    /** Releases the owned application reference on its required thread. */
    deinit() {
      require_thread();
      if (this.pointer != null) {
        unsafe { gobject.raw.g_object_unref(this.pointer); };
      }
    }

    /** Exposes a borrowed handle only to code accepting the unsafe FFI contract. */
    public const unsafe method raw_handle() raw_ptr<u8> {
      require_thread();
      return this.pointer;
    }

    /** Processes one main-context iteration; callers consume widget events afterwards. */
    public method iterate(block: bool) void {
      require_thread();
      unsafe { sg_ui_require_manual_iteration(); };
      if (this.stopped == false) {
        unsafe { glib.raw.g_main_context_iteration(null, block ? 1 : 0); };
      }
    }

    /** Requests that the application's explicit event loop stop. */
    public method quit() void {
      require_thread();
      this.stopped = true;
    }

    /** Reports whether quit has been requested. */
    public const method running() bool {
      require_thread();
      return this.stopped == false;
    }
  }

  /** Owns a button reference and its click queue independently of widget parenting. */
  public class Button {
    var pointer: raw_ptr<u8> = null;
    var events: raw_ptr<u8> = null;
    /** Creates a labeled button after validating its text and initializing GTK. */
    init(label: ref String) SystemResult<void> {
      require_thread();
      try validate(label);
      if (unsafe { gtk_init_check(); } == 0) {
        return SystemResult.Error(Error(1, "Cannot initialize the GTK display"));
      }
      this.pointer = unsafe { raw.gtk_button_new_with_label(label.c_str()); };
      unsafe { gobject.raw.g_object_ref_sink(this.pointer); };
      this.events = unsafe { sg_button_events_new(this.pointer); };
    }

    /** Disconnects native signal state before releasing the owned button. */
    deinit() {
      require_thread();
      if (this.events != null) {
        unsafe { sg_button_events_free(this.events); };
      }
      if (this.pointer != null) {
        unsafe { gobject.raw.g_object_unref(this.pointer); };
      }
    }

    /** Exposes a borrowed handle only to code accepting the unsafe FFI contract. */
    public const unsafe method raw_handle() raw_ptr<u8> {
      require_thread();
      return this.pointer;
    }

    /** Sets a validated label; GTK copies the supplied text. */
    public method set_label(label: ref String) SystemResult<void> {
      require_thread();
      try validate(label);
      unsafe { raw.gtk_button_set_label(this.pointer, label.c_str()); };
      return SystemResult.Ok;
    }

    /** Copies the label into Sun-owned storage. */
    public const method label() String {
      require_thread();
      var a = make_heap_allocator();
      var text = unsafe { raw.gtk_button_get_label(this.pointer); };
      if (text == null) {
        return String("");
      }
      return from_c_str(a, text);
    }

    /** Requests native focus, returning whether GTK accepted it. */
    public method focus() bool {
      require_thread();
      return unsafe { raw.gtk_widget_grab_focus(this.pointer); } != 0;
    }

    /** Reports whether this button currently owns native focus. */
    public const method is_focused() bool {
      require_thread();
      return unsafe { raw.gtk_widget_is_focus(this.pointer); } != 0;
    }

    /** Consumes one click without invoking user code inside a native callback. */
    public method take_click() bool {
      require_thread();
      return unsafe { sg_button_events_take(this.events); } != 0;
    }

    /** Emits a clicked event, useful for keyboard actions and automated tests. */
    public method click() void {
      require_thread();
      unsafe { sg_button_emit_clicked(this.pointer); };
    }
  }

  /** Selects the native axis used by a GTK box. */
  public enum Orientation { Horizontal, Vertical }

  /** Owns a GTK box independently of its parent and its child wrappers. */
  public class Box {
    var pointer: raw_ptr<u8> = null;
    /** Creates a layout container with nonnegative spacing between children. */
    init(orientation: Orientation, spacing: i32) SystemResult<void> {
      require_thread();
      if (spacing < 0) {
        return SystemResult.Error(Error(1, "Box spacing must be nonnegative"));
      }
      if (unsafe { gtk_init_check(); } == 0) {
        return SystemResult.Error(Error(1, "Cannot initialize the GTK display"));
      }
      this.pointer = unsafe { raw.gtk_box_new(orientation == Orientation.Vertical ? 1 : 0, spacing); };
      unsafe { gobject.raw.g_object_ref_sink(this.pointer); };
    }

    /** Releases this wrapper's reference without invalidating independently owned children. */
    deinit() {
      require_thread();
      if (this.pointer != null) {
        unsafe { gobject.raw.g_object_unref(this.pointer); };
      }
    }

    /** Borrows the native handle for callers accepting the unsafe FFI contract. */
    public const unsafe method raw_handle() raw_ptr<u8> {
      require_thread();
      return this.pointer;
    }

    /** Inserts or reorders a child after a validated sibling without unparenting it. */
    method place(button: ref Button, sibling: raw_ptr<u8>) SystemResult<void> {
      require_thread();
      var child = unsafe { button.raw_handle(); };
      var parent = unsafe { gtk_widget_get_parent(child); };
      if (parent != null and parent != this.pointer) {
        return SystemResult.Error(Error(1, "Button belongs to another parent"));
      }
      if (sibling != null and (sibling == child or unsafe { gtk_widget_get_parent(sibling); } != this.pointer)) {
        return SystemResult.Error(Error(1, "Sibling must be another child of this box"));
      }
      if (parent == null) {
        unsafe { raw.gtk_box_append(this.pointer, child); };
      }
      if (unsafe { raw.gtk_widget_get_prev_sibling(child); } != sibling) {
        unsafe { raw.gtk_box_reorder_child_after(this.pointer, child, sibling); };
      }
      return SystemResult.Ok;
    }

    /** Places a button first, retaining existing native identity and focus. */
    public method place_first(button: ref Button) SystemResult<void> {
      return this.place(button, null);
    }

    /** Places a button after another child of this box. */
    public method place_after(button: ref Button, previous: ref Button) SystemResult<void> {
      return this.place(button, unsafe { previous.raw_handle(); });
    }

    /** Removes this box's reference to a child, returning false if it is not parented here. */
    public method remove(button: ref Button) bool {
      require_thread();
      var child = unsafe { button.raw_handle(); };
      if (unsafe { gtk_widget_get_parent(child); } != this.pointer) {
        return false;
      }
      unsafe { raw.gtk_box_remove(this.pointer, child); };
      return true;
    }

    /** Reports whether a button is the first child of this box. */
    public const method is_first(button: ref Button) bool {
      require_thread();
      var child = unsafe { button.raw_handle(); };
      return unsafe { gtk_widget_get_parent(child); } == this.pointer and unsafe { raw.gtk_widget_get_prev_sibling(child); } == null;
    }

    /** Reports whether two buttons are consecutive children of this box. */
    public const method follows(button: ref Button, previous: ref Button) bool {
      require_thread();
      var child = unsafe { button.raw_handle(); };
      return unsafe { gtk_widget_get_parent(child); } == this.pointer and unsafe { raw.gtk_widget_get_prev_sibling(child); } == unsafe { previous.raw_handle(); };
    }
  }

  /** Owns a top-level window and destroys it before releasing its reference. */
  public class Window {
    var pointer: raw_ptr<u8> = null;
    /** Creates a window associated with a registered application. */
    init(application: ref Application) {
      require_thread();
      this.pointer = unsafe { raw.gtk_application_window_new(application.raw_handle()); };
      unsafe { gobject.raw.g_object_ref(this.pointer); };
    }

    /** Creates a window from a callback context's retained application. */
    init(core: ref LoopCore) {
      require_thread();
      this.pointer = unsafe { raw.gtk_application_window_new(sg_loop_application(core.pointer)); };
      unsafe { gobject.raw.g_object_ref(this.pointer); };
    }

    /** Borrows the window handle only for code accepting the unsafe native contract. */
    public const unsafe method raw_handle() raw_ptr<u8> {
      require_thread();
      return this.pointer;
    }

    /** Closes the window and releases this wrapper's independent reference. */
    deinit() {
      require_thread();
      this.close();
      unsafe { gobject.raw.g_object_unref(this.pointer); };
    }

    /** Reports whether the window remains attached to its application. */
    public const method is_open() bool {
      require_thread();
      return unsafe { sg_window_is_open(this.pointer); } != 0;
    }

    /** Rejects operations after a user close or explicit destruction. */
    method check_open() SystemResult<void> {
      if (this.is_open() == false) {
        return SystemResult.Error(Error(1, "Window is closed"));
      }
      return SystemResult.Ok;
    }

    /** Sets a validated title on an open window. */
    public method set_title(title: ref String) SystemResult<void> {
      require_thread();
      try this.check_open();
      try validate(title);
      unsafe { raw.gtk_window_set_title(this.pointer, title.c_str()); };
      return SystemResult.Ok;
    }

    /** Sets positive default dimensions on an open window. */
    public method set_default_size(width: i32, height: i32) SystemResult<void> {
      require_thread();
      try this.check_open();
      if (width <= 0 or height <= 0) {
        return SystemResult.Error(Error(1, "Window dimensions must be positive"));
      }
      unsafe { raw.gtk_window_set_default_size(this.pointer, width, height); };
      return SystemResult.Ok;
    }

    /** Parents an unparented button; both wrappers retain independent ownership. */
    public method set_child(button: ref Button) SystemResult<void> {
      require_thread();
      try this.check_open();
      var child = unsafe { button.raw_handle(); };
      if (unsafe { gtk_widget_get_parent(child); } != null) {
        return SystemResult.Error(Error(1, "Button already has a parent"));
      }
      unsafe { raw.gtk_window_set_child(this.pointer, child); };
      return SystemResult.Ok;
    }

    /** Parents an unparented box while preserving both wrappers' independent references. */
    public method set_box(box: ref Box) SystemResult<void> {
      require_thread();
      try this.check_open();
      var child = unsafe { box.raw_handle(); };
      if (unsafe { gtk_widget_get_parent(child); } != null) {
        return SystemResult.Error(Error(1, "Box already has a parent"));
      }
      unsafe { raw.gtk_window_set_child(this.pointer, child); };
      return SystemResult.Ok;
    }

    /** Presents an open window. */
    public method present() SystemResult<void> {
      require_thread();
      try this.check_open();
      unsafe { raw.gtk_window_present(this.pointer); };
      return SystemResult.Ok;
    }

    /** Destroys the window once; repeated closes have no effect. */
    public method close() void {
      require_thread();
      if (this.is_open()) {
        unsafe { raw.gtk_window_destroy(this.pointer); };
      }
    }
  }
}
