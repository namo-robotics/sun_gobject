using std;
using sg;

/** Parses generator options, validates selected declarations, and writes deterministic artifacts. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) AllocationResult<i32> {
  var a = make_heap_allocator();
  var env = try std.env.Env(a);
  var args = try env.args(argc, argv);
  var repo = try gir.Repository();
  var selection = try String("");
  var output = try String("");
  var source_output = try String("");
  var target = try String("");
  var sun_revision = try String("unknown");
  var revision = try String("unknown");
  var overrides = try String("");
  for (var i: i64 = 1; i < args.size(); i += 1) {
    if (args[i].equals_literal("--check-xml")) {
      if (i + 1 >= args.size()) {
        die("--check-xml requires a path");
      }
      var path = try args[i + 1].clone(a);
      var data = try read(path);
      var doc = try xml.Document(data, path);
      try doc.parse();
      std.io.println("XML OK");
      return AllocationResult.Ok(0);
    }
    if (i + 1 >= args.size()) {
      die("option requires a value");
    }
    var value = try args[i + 1].clone(a);
    if (args[i].equals_literal("--gir-dir")) {
      try repo.dirs.push(value);
    } else if (args[i].equals_literal("--selection")) {
      selection = value;
    } else if (args[i].equals_literal("--output-dir")) {
      output = value;
    } else if (args[i].equals_literal("--source-dir")) {
      source_output = value;
    } else if (args[i].equals_literal("--target")) {
      target = value;
    } else if (args[i].equals_literal("--sun-revision")) {
      sun_revision = value;
    } else if (args[i].equals_literal("--generator-revision")) {
      revision = value;
    } else if (args[i].equals_literal("--overrides")) {
      overrides = value;
    } else {
      fail(args[i]);
    }
    i += 1;
  }
  if (selection.length() == 0 or output.length() == 0 or
    (not target.equals_literal("x86_64-linux-gnu") and
      not target.equals_literal("arm64-apple-darwin"))) {
    die(
      "usage: sun-gir --selection FILE --output-dir DIR --target TARGET (x86_64-linux-gnu or arm64-apple-darwin) [--source-dir DIR] [--gir-dir DIR ...] [--overrides FILE]"
    );
  }
  if (source_output.length() == 0) {
    source_output = try output.clone(a);
  }
  try repo.dirs.push(try String("/usr/share/gir-1.0"));

  if (target.equals_literal("x86_64-linux-gnu")) {
    try repo.dirs.push(try String("/usr/lib/x86_64-linux-gnu/gir-1.0"));
  }
  var selection_data = try read(selection);
  var selection_hash = try gir.sha256(selection_data);
  var selected = try xml.Document(selection_data, selection);
  try selected.parse();
  for (var i: i64 = 0; i < selected.nodes.size(); i += 1) {
    if (selected.nodes[i].name.equals_literal("namespace")) {
      var name = try selected.nodes[i].attr("name");
      var version = try selected.nodes[i].attr("version");
      try repo.load(name, version);
    }
  }
  var override_hash = try String("");
  if (overrides.length() > 0) {
    var contents = try read(overrides);
    override_hash = try gir.sha256(contents);
    var patches = try xml.Document(contents, overrides);
    try patches.parse();
    for (var p: i64 = 1; p < patches.nodes.size(); p += 1) {
      if (patches.nodes[p].name.equals_literal("set") == false) {
        die("unknown metadata override");
      }
      var symbol = try patches.nodes[p].attr("symbol");
      var key = try patches.nodes[p].attr("attribute");
      var value = try patches.nodes[p].attr("value");
      var matches: i64 = 0;
      for (var d: i64 = 0; d < repo.docs.size(); d += 1) {
        for (var n: i64 = 0; n < repo.docs[d].nodes.size(); n += 1) {
          var id = try repo.docs[d].nodes[n].attr("c:identifier");
          if (id.equals(symbol)) {
            matches += 1;
            var changed = false;
            for (var j: i64 = 0; j < repo.docs[d].nodes[n].attributes.size(); j += 1) {
              if (repo.docs[d].nodes[n].attributes[j].name.equals(key)) {
                repo.docs[d].nodes[n].attributes[j].value = try value.clone(a);
                changed = true;
              }
            }
            if (changed == false) {
              try repo.docs[d].nodes[n].attributes.push(
                xml.Attribute(
                  try key.clone(a),
                  try value.clone(a)
                )
              );
            }
          }
        }
      }
      if (matches != 1) {
        die("override must match exactly one declaration");
      }
    }
  }
  var files = try Vec<String>(a, 8);
  var contents = try Vec<String>(a, 8);
  var coverage = try String("namespace\tsymbol\tstatus\treason\n");
  for (var s: i64 = 0; s < selected.nodes.size(); s += 1) {
    if (selected.nodes[s].name.equals_literal("namespace") == false) {
      continue;
    }
    var ns = try selected.nodes[s].attr("name");
    var version = try selected.nodes[s].attr("version");
    var module_name = try selected.nodes[s].attr("module");
    // Restrict module/output names to identifiers to prevent code/path injection.
    for (var i: i64 = 0; i < module_name.length(); i += 1) {
      var c = byte(module_name, i);
      if ((c >= 97 and c <= 122) == false and c != 95) {
        die("invalid module name");
      }
    }
    if (module_name.length() == 0) {
      die("empty module name");
    }
    var key = try ns.clone(a);
    try key.append("-");
    try key.append(version);
    var d: i64 = -1;
    for (var k: i64 = 0; k < repo.keys.size(); k += 1) {
      if (repo.keys[k].equals(key)) {
        d = k;
      }
    }
    if (d < 0) {
      die("namespace not loaded");
    }
    var source = try String(
      "// Generated by sun-gir. Do not edit. Raw calls require unsafe.\npublic module "
    );

    try source.append(module_name);
    try source.append(".raw {\n\n");
    try source.append(
      target.equals_literal("arm64-apple-darwin") ? "  _assert_c_target(\"arm64-apple-darwin\");\n" : "  _assert_c_target(\"x86_64-pc-linux-gnu\");\n"
    );

    var emitted = try Vec<String>(a, 32);
    for (var f = s + 1; f < selected.nodes.size(); f += 1) {
      if (selected.nodes[f].parent != s) {
        continue;
      }
      var symbol = try selected.nodes[f].attr("symbol");
      for (var k: i64 = 0; k < emitted.size(); k += 1) {
        if (emitted[k].equals(symbol)) {
          die("duplicate selected symbol");
        }
      }
      var found: i64 = -1;
      for (var n: i64 = 0; n < repo.docs[d].nodes.size(); n += 1) {
        var id = try repo.docs[d].nodes[n].attr("c:identifier");
        if (id.equals(symbol)) {
          found = n;
          break;
        }
      }
      if (found < 0) {
        var error = try String("selected symbol not found: ");
        try error.append(symbol);
        fail(error);
      }
      var decl = try gir.declaration(repo, repo.docs[d], found);
      try source.append(decl);
      try emitted.push(symbol);
    }
    for (var n: i64 = 0; n < repo.docs[d].nodes.size(); n += 1) {
      var id = try repo.docs[d].nodes[n].attr("c:identifier");
      if (id.length() == 0) {
        continue;
      }
      var chosen = false;
      for (var k: i64 = 0; k < emitted.size(); k += 1) {
        if (emitted[k].equals(id)) {
          chosen = true;
        }
      }
      try coverage.append(ns);
      try coverage.append("\t");
      try coverage.append(id);
      try coverage.append(
        chosen ? "\temitted\tselected and representable\n" : "\tunselected\toutside curated surface; ABI support not evaluated\n"
      );
    }
    try source.append("}\n");
    var filename = try module_name.clone(a);
    try filename.append(".sun");
    try files.push(filename);
    try contents.push(source);
  }
  // Preserve the full parsed GIR tree as JSON, including ownership, callback scope,
  // array lengths, properties, signals, inheritance and dependency types.
  var model = try String("[\n");
  for (var d: i64 = 0; d < repo.docs.size(); d += 1) {
    if (d > 0) {
      try model.append(",\n");
    }
    try model.append("{\"namespace\":");
    var key = try gir.quote(repo.keys[d]);
    try model.append(key);
    try model.append(",\"nodes\":[");
    for (var n: i64 = 0; n < repo.docs[d].nodes.size(); n += 1) {
      if (n > 0) {
        try model.append(",");
      }
      try model.append("{\"tag\":");
      var tag = try gir.quote(repo.docs[d].nodes[n].name);
      try model.append(tag);
      try model.append(",\"parent\":");
      try model.append(repo.docs[d].nodes[n].parent);
      try model.append(",\"attributes\":{");
      for (var k: i64 = 0; k < repo.docs[d].nodes[n].attributes.size(); k += 1) {
        if (k > 0) {
          try model.append(",");
        }
        var name = try gir.quote(repo.docs[d].nodes[n].attributes[k].name);
        var value = try gir.quote(repo.docs[d].nodes[n].attributes[k].value);
        try model.append(name);
        try model.append(":");
        try model.append(value);
      }
      try model.append("}}");
    }
    try model.append("]}");
  }
  try model.append("\n]\n");
  var provenance = try String("{\"target\":");
  var q = try gir.quote(target);
  try provenance.append(q);
  try provenance.append(",\"sun_revision\":");
  q = try gir.quote(sun_revision);
  try provenance.append(q);
  try provenance.append(",\"generator_revision\":");
  q = try gir.quote(revision);
  try provenance.append(q);
  try provenance.append(",\"selection_sha256\":");
  q = try gir.quote(selection_hash);
  try provenance.append(q);
  try provenance.append(",\"overrides_sha256\":");
  q = try gir.quote(override_hash);
  try provenance.append(q);
  try provenance.append(",\"gir\":{");
  for (var k: i64 = 0; k < repo.keys.size(); k += 1) {
    if (k > 0) {
      try provenance.append(",");
    }
    q = try gir.quote(repo.keys[k]);
    try provenance.append(q);
    try provenance.append(":");
    q = try gir.quote(repo.hashes[k]);
    try provenance.append(q);
  }
  try provenance.append("}}\n");
  try files.push(try String("coverage.tsv"));

  try contents.push(coverage);
  try files.push(try String("gir-model.json"));

  try contents.push(model);
  try files.push(try String("provenance.json"));

  try contents.push(provenance);
  // Validate every declaration before touching output files.
  for (var i: i64 = 0; i < files.size(); i += 1) {
    var path = try output.clone(a);
    if (files[i].ends_with(".sun")) {
      path = try source_output.clone(a);
    }
    try path.append("/");
    try path.append(files[i]);
    write(path, contents[i]);
  }
  std.io.println("GIR generation complete");
  return AllocationResult.Ok(0);
}
manifest {
  source_files: [
    "../results.sun",
    "common.sun",
    "xml.sun",
    "gir.sun"
  ] libraries: [
    "stdlib.moon"
  ]
}
