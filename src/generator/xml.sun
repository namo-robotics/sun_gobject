using std;
using sg;

/** Adapts standard-library XML events to the indexed tree used by GIR. */
public module xml {

  /** Owns one namespace-qualified attribute name and its decoded value. */
  public class Attribute {
    public var name: String;
    public var value: String;

    /** Initializes Attribute with the supplied owned values or native pointer contract. */
    init(name: String, value: String) {
      this.name = name;
      this.value = value;
    }
  }

  /** Stores one element, its decoded content, and its parent index. */
  public class Node {
    public var name: String;
    public var attributes: Vec<Attribute>;
    public var text: String;
    public var parent: i64;

    /** Initializes Node with the supplied owned values or native pointer contract. */
    init(name: String, parent: i64) throws {
      var a = make_heap_allocator();
      this.name = name;
      this.parent = parent;
      this.attributes = Vec<Attribute>(a, 4);
      this.text = String(a, "");
    }

    /** Copies an attribute value, returning an empty string when absent. */
    public const method attr(key: static_ptr<u8>) String throws {
      var a = make_heap_allocator();
      for (var i: i64 = 0; i < this.attributes.size(); i += 1) {
        if (this.attributes[i].name.equals_literal(key)) {
          return this.attributes[i].value.clone(a);
        }
      }
      return String(a, "");
    }
  }

  /** Maps expanded names to the stable names consumed by GIR generation. */
  function canonical(name: const ref std.xml.XmlName) String throws {
    var a = make_heap_allocator();
    var uri = name.uri();
    var result = String("");
    if (uri.is_empty() or uri.equals_literal("http://www.gtk.org/introspection/core/1.0")) {
      return name.local().clone(a);
    }
    if (uri.equals_literal("http://www.gtk.org/introspection/c/1.0")) {
      result.append("c:");
    } else if (uri.equals_literal("http://www.gtk.org/introspection/glib/1.0")) {
      result.append("glib:");
    } else if (uri.equals_literal("http://www.w3.org/XML/1998/namespace")) {
      result.append("xml:");
    } else {
      result.append("{");
      result.append(uri);
      result.append("}");
    }
    result.append(name.local());
    return result;
  }

  /** Copies a reader element into the generator's indexed representation. */
  function node(element: const ref std.xml.XmlElement, parent: i64) Node throws {
    var a = make_heap_allocator();
    var result = Node(canonical(element.name()), parent);
    for (var i: i64 = 0; i < element.namespace_count(); i += 1) {
      var declaration = element.namespace_at(i);
      var name = String("xmlns");
      if (not declaration.declared_prefix().is_empty()) {
        name.append(":");
        name.append(declaration.declared_prefix());
      }
      result.attributes.push(
        Attribute(name, declaration.namespace_uri().clone(a))
      );
    }
    for (var i: i64 = 0; i < element.attribute_count(); i += 1) {
      var name = element.attribute_name(i);
      match element.attribute(name) {
        Option.Some(value) => {
          result.attributes.push(
            Attribute(canonical(name), value.clone(a))
          );
        },
        Option.None => {}
      };
    }
    return result;
  }

  /** Owns input and the GIR tree; standard-library XML owns all parsing rules. */
  public class Document {
    public var nodes: Vec<Node>;
    var input: String;
    var filename: String;

    /** Retains original input so diagnostics refer to the supplied file. */
    init(input: String, filename: String) throws {
      var a = make_heap_allocator();
      this.nodes = Vec<Node>(a, 64);
      this.input = input;
      this.filename = filename;
    }

    /** Converts owned reader events without retaining borrows into parser state. */
    method read() void throws {
      var a = make_heap_allocator();
      var reader = std.xml.XmlReader(a, this.input);
      var current: i64 = -1;
      this.nodes.clear();
      while (true) {
        match reader.next() {
          Option.None => {
            return;
          },
          Option.Some(event) => {
            match event {
              std.xml.XmlEvent.Start(element) => {
                var item = node(element, current);
                current = this.nodes.size();
                this.nodes.push(item);
              },
              std.xml.XmlEvent.End(_) => {
                current = this.nodes[current].parent;
              },
              std.xml.XmlEvent.Text(text) => {
                if (current >= 0) {
                  this.nodes[current].text.append(text);
                }
              },
              std.xml.XmlEvent.Comment(_) => {},
              std.xml.XmlEvent.Instruction(_) => {}
            };
          }
        };
      }
      return;
    }

    /** Stops generation on malformed XML, preserving filename and source location. */
    public method parse() void throws {
      try {
        this.read();
      } catch (error: std.xml.XmlError) {
        var a = make_heap_allocator();
        var message = this.filename.clone(a);
        message.append(":");
        message.append(error.line());
        message.append(":");
        message.append(error.column());
        message.append(": ");
        message.append(error.message());

        fail(message);
      } catch {
        _panic("unable to allocate XML parser storage");
      }

      return;
    }
  }
}
