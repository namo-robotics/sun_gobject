/** Bundles generated GTK declarations with checked GTK and SVG wrappers. */
manifest {
  library_id: "namo-robotics/sun_gtk"
  source_files: [
    "generated/gtk.sun",
    "wrappers/gtk/support.sun",
    "wrappers/gtk/widget_support.sun",
    "wrappers/gtk/widget.sun",
    "wrappers/gtk/application.sun",
    "wrappers/gtk/button.sun",
    "wrappers/gtk/box.sun",
    "wrappers/gtk/window.sun",
    "wrappers/gtk/event_support.sun",
    "wrappers/gtk/loop_core.sun",
    "wrappers/gtk/id_seed.sun",
    "wrappers/gtk/registration_id.sun",
    "wrappers/gtk/queued_source.sun",
    "wrappers/gtk/native_event.sun",
    "wrappers/gtk/event_queue.sun",
    "wrappers/gtk/handler.sun",
    "wrappers/gtk/event_context.sun",
    "wrappers/gtk/event_loop.sun",
    "wrappers/gtk/drawing_support.sun",
    "wrappers/gtk/label.sun",
    "wrappers/gtk/drawing_area.sun",
    "wrappers/gtk/gl_area.sun",
    "wrappers/gtk/save_dialog.sun",
    "wrappers/gtk/open_dialog.sun",
    "wrappers/svg/raw.sun",
    "wrappers/svg/viewport.sun",
    "wrappers/svg/document.sun"
  ]
  libraries: [
    "sun_gobject.moon",
    "stdlib.moon"
  ]
}
