/** Bundles generated GLib, GObject, and GIO declarations with ownership helpers. */
manifest {
  source_files: [
    "${SUN_BUILD}/generated/sources/glib.sun",
    "${SUN_BUILD}/generated/sources/gobject.sun",
    "${SUN_BUILD}/generated/sources/gio.sun",
    "wrappers/core.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
}
