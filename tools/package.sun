using std;

/** Packages already-built Linux development artifacts for downstream applications. */
module release_package {

  /** Runs a packaging utility and propagates its exit status. */
  function run(command: ref std.process.Command) void throws {
    var status = command.status();
    if (status != 0) {
      throw Error(status, "Release packaging failed");
    }
    return;
  }

  /** Copies a required artifact with its installation permissions. */
  function install(source: String, destination: String, executable: bool) void throws {
    var command = std.process.Command(make_heap_allocator(), "install");

    command.add_arg("-D");
    command.add_arg("-m");
    command.add_arg(executable ? "755" : "644");
    command.add_arg(source);
    command.add_arg(destination);
    return run(command);
  }

  /** Creates a Debian package without rebuilding or fetching any dependency. */
  public function package() void throws {
    var a = make_heap_allocator();
    var arch = std.process.Command(a, "dpkg");
    arch.add_arg("--print-architecture");
    var result = arch.output();
    var architecture = result.stdout().clone(a);
    architecture.trim();
    if (result.status() != 0 or not architecture.equals_literal("amd64")) {
      throw Error(1, "Linux release packages require amd64");
    }
    var root = String("build/release-package/root");
    var clear = std.process.Command(a, "rm");
    clear.add_arg("-rf");
    clear.add_arg(root);
    run(clear);
    install(
      String("build/sun_gobject.moon"),
      `${root}/usr/lib/sun/sun_gobject.moon`,
      false
    );
    install(
      String("build/sun_gtk.moon"),
      `${root}/usr/lib/sun/sun_gtk.moon`,
      false
    );
    install(
      String("build/native/libsun_gobject_native.a"),
      `${root}/usr/lib/sun/native/libsun_gobject_native.a`,
      false
    );
    install(
      String("build/sun_capture.moon"),
      `${root}/usr/lib/sun/sun_capture.moon`,
      false
    );
    install(
      String("build/native/libsun_capture_native.a"),
      `${root}/usr/lib/sun/native/libsun_capture_native.a`,
      false
    );
    install(
      String("LICENSE"),
      `${root}/usr/share/doc/sun-gobject/copyright`,
      false
    );
    install(
      String("build/sun-version.txt"),
      `${root}/usr/share/doc/sun-gobject/sun-version.txt`,
      false
    );
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg(`${root}/DEBIAN`);
    run(mkdir);
    var control = String(
      "Package: sun-gobject\nVersion: 0.dev\nArchitecture: amd64\nMaintainer: David Brown <davidwbrwn@gmail.com>\nDepends: sun, libgtk-4-dev, librsvg2-dev, libgstreamer1.0-dev, libx11-dev, libxext-dev\nSection: libdevel\nPriority: optional\nDescription: Sun development bundles and tools\n Built for Ubuntu 26.04 with the recorded Sun compiler.\n"
    );

    var path = `${root}/DEBIAN/control`;
    std.io.write_string(path, control);
    var archive = std.process.Command(a, "dpkg-deb");
    archive.add_arg("--root-owner-group");
    archive.add_arg("--build");
    archive.add_arg(root);
    archive.add_arg("build/sun-gobject_0.dev_amd64.deb");
    return run(archive);
  }
}

/** Reports packaging failures to release automation. */
function main() i32 throws {
  try {
    release_package.package();
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon"
  ]
}
