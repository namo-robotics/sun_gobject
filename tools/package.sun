using std;

/** Packages already-built Linux development artifacts for downstream applications. */
module release_package {

  /** Runs a packaging utility and propagates its exit status. */
  function run(command: ref std.process.Command) SystemResult<void> {
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Release packaging failed"));
    }
    return SystemResult.Ok;
  }

  /** Copies a required artifact with its installation permissions. */
  function install(source: String, destination: String, executable: bool) SystemResult<void> {
    var command = try std.process.Command(make_heap_allocator(), "install");

    try command.add_arg("-D");
    try command.add_arg("-m");
    try command.add_arg(executable ? "755" : "644");
    try command.add_arg(source);
    try command.add_arg(destination);
    return run(command);
  }

  /** Creates a Debian package without rebuilding or fetching any dependency. */
  public function package() SystemResult<void> {
    var a = make_heap_allocator();
    var arch = try std.process.Command(a, "dpkg");
    try arch.add_arg("--print-architecture");
    var result = try arch.output();
    var architecture = try result.stdout().clone(a);
    architecture.trim();
    if (result.status() != 0 or not architecture.equals_literal("amd64")) {
      return SystemResult.Error(Error(1, "Linux release packages require amd64"));
    }
    var root = try String("build/release-package/root");
    var clear = try std.process.Command(a, "rm");
    try clear.add_arg("-rf");
    try clear.add_arg(root);
    try run(clear);
    try install(
      try String("build/sun_gobject.moon"),
      try `${root}/usr/lib/sun/sun_gobject.moon`,
      false
    );
    try install(
      try String("build/sun_gtk.moon"),
      try `${root}/usr/lib/sun/sun_gtk.moon`,
      false
    );
    try install(
      try String("build/native/libsun_gobject_native.a"),
      try `${root}/usr/lib/sun/native/libsun_gobject_native.a`,
      false
    );
    try install(
      try String("build/sun_capture.moon"),
      try `${root}/usr/lib/sun/sun_capture.moon`,
      false
    );
    try install(
      try String("build/native/libsun_capture_native.a"),
      try `${root}/usr/lib/sun/native/libsun_capture_native.a`,
      false
    );
    try install(
      try String("LICENSE"),
      try `${root}/usr/share/doc/sun-gobject/copyright`,
      false
    );
    try install(
      try String("build/sun-version.txt"),
      try `${root}/usr/share/doc/sun-gobject/sun-version.txt`,
      false
    );
    var mkdir = try std.process.Command(a, "mkdir");
    try mkdir.add_arg("-p");
    try mkdir.add_arg(try `${root}/DEBIAN`);
    try run(mkdir);
    var control = try String(
      "Package: sun-gobject\nVersion: 0.dev\nArchitecture: amd64\nMaintainer: David Brown <davidwbrwn@gmail.com>\nDepends: sun, libgtk-4-dev, librsvg2-dev, libgstreamer1.0-dev, libx11-dev, libxext-dev\nSection: libdevel\nPriority: optional\nDescription: Sun development bundles and tools\n Built for Ubuntu 26.04 with the recorded Sun compiler.\n"
    );

    var path = try `${root}/DEBIAN/control`;
    try std.io.write_string(path, control);
    var archive = try std.process.Command(a, "dpkg-deb");
    try archive.add_arg("--root-owner-group");
    try archive.add_arg("--build");
    try archive.add_arg(root);
    try archive.add_arg("build/sun-gobject_0.dev_amd64.deb");
    return run(archive);
  }
}

/** Reports packaging failures to release automation. */
function main() AllocationResult<i32> {
  return AllocationResult.Ok(
    match release_package.package() {
      SystemResult.Ok => 0,
      SystemResult.Error(error) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  source_files: [
    "../src/results.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
}
