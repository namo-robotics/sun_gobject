using std;

/** Verifies that the selected compiler provides the standard-library XML reader. */
function main() i32 throws {
  var a = make_heap_allocator();
  var input = String("<probe/>");
  var reader = std.xml.XmlReader(a, input);
  try {
    reader.next();
    return 0;
  } catch {
    return 1;
  }
}
