using std;

/** Builds and installs Sun artifacts using separately compiled native libraries. */
module build_tasks {

  /** Runs a command, preserving diagnostics and returning failure to the caller. */
  function capture(command: ref std.process.Command) SystemResult<String> {
    var a = make_heap_allocator();
    var output = try command.output();
    if (output.status() != 0) {
      std.io.eprintln(output.stdout());
      std.io.eprintln(output.stderr());
      return SystemResult.Error(Error(output.status(), "Build command failed"));
    }
    var text = try output.stdout().clone(a);
    try text.append(output.stderr());
    text.trim();
    return SystemResult.Ok(text);
  }

  /** Streams build diagnostics and returns a failed command status to the caller. */
  function run(command: ref std.process.Command) SystemResult<void> {
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Build command failed"));
    }
    return SystemResult.Ok;
  }

  /** Selects the requested compiler or the compiler on PATH. */
  function compiler() AllocationResult<String> {
    var a = make_heap_allocator();
    var env = try std.env.Env(a);
    return AllocationResult.Ok(
      match env.get("SUN_EXECUTABLE") {
        Option.Some(value) => try value.clone(a),
        Option.None => try String("sun")
      }
    );
  }

  /** Creates a compiler command with this project's bundle and native paths. */
  function compile(native: bool) SystemResult<std.process.Command> {
    var a = make_heap_allocator();
    var executable = try compiler();
    var command = try std.process.Command(a, executable);
    try command.add_arg("--dynamic");
    // This test harness explicitly keeps its native fixtures in build/.
    try command.add_arg("--path-var");
    try command.add_arg("SUN_BUILD=build");
    try command.add_arg("--lib-path");
    try command.add_arg("build");
    if (native) {
      try command.add_arg("-Lbuild/native");
    }
    return SystemResult.Ok(command);
  }

  /** Adds system dependencies after static archives so the linker resolves their symbols. */
  function link_gtk(command: ref std.process.Command) SystemResult<void> {
    var a = make_heap_allocator();
    var pkg = try std.process.Command(a, "pkg-config");
    try pkg.add_arg("--libs");
    try pkg.add_arg("gtk4");
    try pkg.add_arg("gio-2.0");
    var flags = try capture(pkg);
    var words = try flags.split_whitespace(a);
    for (var word: ref String in words) {
      try command.add_arg(word);
    }
    try command.add_arg("-l:librsvg-2.so.2");
    try command.add_arg("-lm");
    return SystemResult.Ok;
  }

  /** Forces relinking when a native dependency changed outside Sun's source cache. */
  function native_dependency(
    command: ref std.process.Command,
    library: static_ptr<u8>,
    output: static_ptr<u8>
  ) SystemResult<void> {
    var a = make_heap_allocator();
    var exists = try std.process.Command(a, "test");
    try exists.add_arg("-f");
    try exists.add_arg(library);
    if (try exists.status() != 0) {
      return SystemResult.Error(
        Error(1, "Build native dependencies before compiling Sun programs")
      );
    }
    var newer = try std.process.Command(a, "test");
    try newer.add_arg(library);
    try newer.add_arg("-nt");
    try newer.add_arg(output);
    if (try newer.status() == 0) {
      try command.add_arg("--force-rebuild");
    }
    return SystemResult.Ok;
  }

  /** Writes text only when it changed, preserving incremental test freshness. */
  function write(path: ref String, value: ref String) SystemResult<void> {
    var a = make_heap_allocator();
    match std.io.read_to_string(a, path) {
      SystemResult.Ok(previous) => {
        if (previous.equals(value)) {
          return SystemResult.Ok;
        }
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    return std.io.write_string(path, value);
  }

  /** Escapes a filesystem path for insertion into generated Sun string literals. */
  function quote_path(value: ref String) AllocationResult<void> {
    try value.replace("\\", "\\\\");
    try value.replace("\"", "\\\"");
    return AllocationResult.Ok;
  }

  /** Records compiler and source provenance and generates test path constants. */
  public function prepare() SystemResult<String> {
    var a = make_heap_allocator();
    var mkdir = try std.process.Command(a, "mkdir");
    try mkdir.add_arg("-p");
    try mkdir.add_arg("build/generated");
    try mkdir.add_arg("build/generated/sources");
    try mkdir.add_arg("tmp");
    try run(mkdir);
    var pwd = try std.process.Command(a, "pwd");
    var root = try capture(pwd);
    var executable = try compiler();
    var locate = try std.process.Command(a, "which");
    try locate.add_arg(executable);
    var compiler_path = try capture(locate);
    var template_path = try String("tests/build_config.sun.in");
    var template = try std.io.read_to_string(a, template_path);
    var build = try root.clone(a);
    try build.append("/build");
    try quote_path(root);
    try quote_path(build);
    try quote_path(compiler_path);
    var root_key = try String("@WORKSPACE_ROOT@");
    try template.replace(root_key, root);
    var build_key = try String("@BUILD_DIR@");
    try template.replace(build_key, build);
    var compiler_key = try String("@SUN_COMPILER@");
    try template.replace(compiler_key, compiler_path);
    var config_path = try String("build/test-config.sun");
    try write(config_path, template);
    var version = try std.process.Command(a, executable);
    try version.add_arg("--version");
    var text = try capture(version);
    var version_path = try String("build/sun-version.txt");
    try write(version_path, text);
    return SystemResult.Ok(text);
  }

  /** Checks XML support before compiling products that require it. */
  function check_xml() SystemResult<void> {
    var a = make_heap_allocator();
    var executable = try compiler();
    var probe = try std.process.Command(a, executable);
    try probe.add_arg("--dynamic");
    try probe.add_arg("-c");
    try probe.add_arg("-o");
    try probe.add_arg("build/xml_probe");
    try probe.add_arg("tools/xml_probe.sun");
    if (try probe.status() != 0) {
      return SystemResult.Error(
        Error(
          1,
          "XML support is required. Update the Sun development package or set SUN_EXECUTABLE to a compiler with std.xml.XmlReader."
        )
      );
    }
    var check = try std.process.Command(a, "build/xml_probe");
    return run(check);
  }

  /** Builds the generator, regenerates bindings, and compiles Sun bundles and programs. */
  public function build() SystemResult<void> {
    var a = make_heap_allocator();
    var version = try prepare();
    try check_xml();
    std.io.println("Compiling GIR generator");
    var generator = try compile(false);
    try generator.add_arg("-lglib-2.0");
    try generator.add_arg("-c");
    try generator.add_arg("-o");
    try generator.add_arg("build/sun_gir");
    try generator.add_arg("src/generator/main.sun");
    try run(generator);
    var revision_command = try std.process.Command(a, "git");
    try revision_command.add_arg("rev-parse");
    try revision_command.add_arg("HEAD");
    var revision = match capture(revision_command) {
      SystemResult.Ok(value) => value,
      SystemResult.Error(_) => try String("unversioned"),
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    // Hash a sorted source list so local edits are recorded in provenance.
    var sorted = try std.process.Command(a, "sh");
    try sorted.add_arg("-eu");
    try sorted.add_arg("-c");
    try sorted.add_arg(
      "LC_ALL=C; export LC_ALL; sha256sum src/generator/*.sun > tmp/generator-sources.sha256; sha256sum tmp/generator-sources.sha256"
    );
    var hash_output = try capture(sorted);
    var words = try hash_output.split_whitespace(a);
    try revision.append(":sources-sha256=");
    try revision.append(words[0]);
    std.io.println("Generating bindings");
    var generate = try std.process.Command(a, "build/sun_gir");
    try generate.add_arg("--selection");
    try generate.add_arg("src/bindings/selection.xml");
    try generate.add_arg("--overrides");
    try generate.add_arg("src/bindings/overrides.xml");
    try generate.add_arg("--output-dir");
    try generate.add_arg("build/generated");
    try generate.add_arg("--source-dir");
    try generate.add_arg("build/generated/sources");
    try generate.add_arg("--target");
    try generate.add_arg("x86_64-linux-gnu");
    try generate.add_arg("--sun-revision");
    try generate.add_arg(version);
    try generate.add_arg("--generator-revision");
    try generate.add_arg(revision);
    try run(generate);
    std.io.println("Compiling Sun bundles");
    var core = try compile(false);
    try core.add_arg("--emit-moon");
    try core.add_arg("-o");
    try core.add_arg("build/sun_gobject.moon");
    try core.add_arg("src/sun_gobject.sun");
    try run(core);
    var gtk = try compile(false);
    try gtk.add_arg("--emit-moon");
    try gtk.add_arg("-o");
    try gtk.add_arg("build/sun_gtk.moon");
    try gtk.add_arg("src/sun_gtk.sun");
    try run(gtk);
    var capture_bundle = try compile(false);
    try capture_bundle.add_arg("--emit-moon");
    try capture_bundle.add_arg("-o");
    try capture_bundle.add_arg("build/sun_capture.moon");
    try capture_bundle.add_arg("src/sun_capture.sun");
    try run(capture_bundle);
    var capture_tests = try compile(true);
    try capture_tests.add_arg("-lsun_capture_test_support");
    try capture_tests.add_arg("-lsun_capture_native");
    var capture_pkg = try std.process.Command(a, "pkg-config");
    try capture_pkg.add_arg("--libs");
    try capture_pkg.add_arg("gio-unix-2.0");
    try capture_pkg.add_arg("gstreamer-1.0");
    try capture_pkg.add_arg("gstreamer-video-1.0");
    try capture_pkg.add_arg("x11");
    try capture_pkg.add_arg("xext");
    var capture_flags = try capture(capture_pkg);
    var capture_words = try capture_flags.split_whitespace(a);
    for (var flag: ref String in capture_words) {
      try capture_tests.add_arg(flag);
    }
    try capture_tests.add_arg("--force-rebuild");
    try capture_tests.add_arg("-c");
    try capture_tests.add_arg("-o");
    try capture_tests.add_arg("build/capture_tests");
    try capture_tests.add_arg("tests/capture.sun");
    try run(capture_tests);
    std.io.println("Compiling GTK demo");
    var demo = try compile(true);
    try demo.add_arg("-l:libsun_gobject_native.a");
    try link_gtk(demo);
    try demo.add_arg("-c");
    try demo.add_arg("-o");
    try demo.add_arg("build/gtk-demo");
    try native_dependency(demo, "build/native/libsun_gobject_native.a", "build/gtk-demo");
    try demo.add_arg("examples/gtk-demo.sun");
    try run(demo);
    std.io.println("Compiling event test client");
    var events = try compile(true);
    try events.add_arg("-lsun_gobject_test_support");
    try link_gtk(events);
    try events.add_arg("-c");
    try events.add_arg("-o");
    try events.add_arg("build/event-client");
    try native_dependency(
      events,
      "build/native/libsun_gobject_test_support.a",
      "build/event-client"
    );
    try events.add_arg("tests/event-client.sun");
    try run(events);
    std.io.println("Compiling drawing widget test client");
    var widgets = try compile(true);
    try widgets.add_arg("-l:libsun_gobject_native.a");
    try link_gtk(widgets);
    try widgets.add_arg("-c");
    try widgets.add_arg("-o");
    try widgets.add_arg("build/widgets-client");
    try native_dependency(widgets, "build/native/libsun_gobject_native.a", "build/widgets-client");
    try widgets.add_arg("tests/widgets-client.sun");
    try run(widgets);
    std.io.println("Compiling Sun tests");
    var tests = try compile(true);
    try tests.add_arg("-lsun_gobject_test_support");
    try link_gtk(tests);
    try tests.add_arg("-c");
    try tests.add_arg("-o");
    try tests.add_arg("build/sun_gobject_tests");
    try native_dependency(
      tests,
      "build/native/libsun_gobject_test_support.a",
      "build/sun_gobject_tests"
    );
    try tests.add_arg("tests/main.sun");
    try run(tests);
    return SystemResult.Ok;
  }

  /** Installs Sun products alongside the independently installed native library. */
  public function install(prefix: ref String) SystemResult<void> {
    var a = make_heap_allocator();
    var native = try std.process.Command(a, "cmake");
    try native.add_arg("--install");
    try native.add_arg("build/native");
    try native.add_arg("--prefix");
    try native.add_arg(prefix);
    try run(native);
    var lib = try prefix.clone(a);
    try lib.append("/lib/sun");
    var bin = try prefix.clone(a);
    try bin.append("/bin");
    var mkdir = try std.process.Command(a, "mkdir");
    try mkdir.add_arg("-p");
    try mkdir.add_arg(lib);
    try mkdir.add_arg(bin);
    try run(mkdir);
    var bundles = try std.process.Command(a, "install");
    try bundles.add_arg("-m644");
    try bundles.add_arg("build/sun_gobject.moon");
    try bundles.add_arg("build/sun_gtk.moon");
    try bundles.add_arg("build/sun_capture.moon");
    try bundles.add_arg(lib);
    try run(bundles);
    var generator = try std.process.Command(a, "install");
    try generator.add_arg("-m755");
    try generator.add_arg("build/sun_gir");
    try generator.add_arg(bin);
    try run(generator);
    return SystemResult.Ok;
  }
}

/** Dispatches Sun-only build, test, or installation work from the workspace root. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) AllocationResult<i32> {
  var a = make_heap_allocator();
  var env = try std.env.Env(a);
  var args = try env.args(argc, argv);
  var result: SystemResult<void> = SystemResult.Ok;
  if (args.size() == 1 or (args.size() == 2 and args[1].equals_literal("build"))) {
    result = build_tasks.build();
  } else if (args.size() == 2 and args[1].equals_literal("prepare")) {
    result = match build_tasks.prepare() {
      SystemResult.Ok(_) => SystemResult.Ok,
      SystemResult.Error(error) => SystemResult.Error(error),
      SystemResult.Allocation(error) => SystemResult.Allocation(error),
      SystemResult.InvalidArgument(error) => SystemResult.InvalidArgument(error),
      SystemResult.Overflow(error) => SystemResult.Overflow(error)
    };
  } else if (args.size() == 3 and args[1].equals_literal("install")) {
    result = build_tasks.install(args[2]);
  } else if (args.size() == 2 and args[1].equals_literal("test")) {
    var media = try std.process.Command(a, "xvfb-run");
    try media.add_arg("-a");
    try media.add_arg("build/native/media-seek-tests");
    match media.status() {
      SystemResult.Ok(status) => {
        if (status != 0) {
          return AllocationResult.Ok(status);
        }
      },
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    };
    var window_test = try std.process.Command(a, "build/native/capture-window-tests");
    match window_test.status() {
      SystemResult.Ok(status) => {
        if (status != 0) {
          return AllocationResult.Ok(status);
        }
      },
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    };
    std.io.println("Running Sun tests");
    var tests = try std.process.Command(a, "build/sun_gobject_tests_test");
    // Separate Xvfb launchers must not compete for display numbers.
    try tests.add_arg("--test-sequential");
    match tests.status() {
      SystemResult.Ok(status) => {
        if (status != 0) {
          return AllocationResult.Ok(status);
        }
        var capture_tests = try std.process.Command(a, "dbus-run-session");
        try capture_tests.add_arg("--");
        try capture_tests.add_arg("xvfb-run");
        try capture_tests.add_arg("-a");
        try capture_tests.add_arg("build/capture_tests_test");
        try capture_tests.add_arg("--test-sequential");
        return AllocationResult.Ok(
          match capture_tests.status() {
            SystemResult.Ok(code) => code,
            (error: const ref IError) => {
              std.io.eprintln(try error.message());
              return AllocationResult.Ok(1);
            }
          }
        );
      },
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    };
  } else {
    std.io.eprintln("Usage: sun tools/build.sun -- [prepare|build|test|install PREFIX]");
    return AllocationResult.Ok(1);
  }
  return AllocationResult.Ok(
    match result {
      SystemResult.Ok => 0,
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  source_files: [
    "../src/results.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
}
