using std;

/** Provides isolated fixtures and bounded commands for the native test suite. */
module checks {

  /** Carries assertion, system, JSON, and bounds failures to the test runner. */
  public enum Result<T> { Ok(T), Assertion(std.test.AssertionError), System(Error), Json(JsonError), Bounds(IndexOutOfBoundsError) }

  /** Owns a unique workspace scratch directory and removes it on scope exit. */
  public class Fixture {
    public var path: String;

    /** Creates a directory without changing the process working directory. */
    init() checks.Result<void> {
      var a = make_heap_allocator();
      var command = std.process.Command(a, "mktemp");
      command.add_arg("-d");
      var pattern = String(test_build.root());
      pattern.append("/tmp/sun-tests.XXXXXX");
      command.add_arg(pattern);
      var output = try std.test.expect_system(command.output());
      try std.test.assert_eq(output.status(), 0);
      var directory = output.stdout().clone(a);
      directory.trim();
      this.path = directory;
    }

    /** Resolves a file beneath this fixture. */
    public method file(name: static_ptr<u8>) String {
      var a = make_heap_allocator();
      var result = this.path.clone(a);
      result.append("/");
      result.append(name);
      return result;
    }

    /** Removes nested fixture files even after an assertion fails. */
    deinit() {
      var a = make_heap_allocator();
      var command = std.process.Command(a, "rm");
      command.add_arg("-rf");
      command.add_arg("--");
      command.add_arg(this.path);
      ignore_error(command.status());
    }
  }

  /** Runs a bounded shell command with fixture, build, compiler, and root arguments. */
  public function command(fixture: ref Fixture, script: static_ptr<u8>) checks.Result<std.process.Output> {
    var a = make_heap_allocator();
    var command = std.process.Command(a, "timeout");
    command.add_arg("30s");
    command.add_arg("sh");
    command.add_arg("-eu");
    command.add_arg("-c");
    command.add_arg(script);
    command.add_arg("sun-tests");
    command.add_arg(fixture.path);
    command.add_arg(test_build.directory());
    command.add_arg(test_build.compiler());
    command.add_arg(test_build.root());
    return checks.Result.Ok(try std.test.expect_system(command.output()));
  }

  /** Reports subprocess diagnostics before asserting its successful exit. */
  public function success(output: ref std.process.Output) checks.Result<void> {
    if (output.status() != 0) {
      eprintln(output.stdout());
      eprintln(output.stderr());
    }
    try std.test.assert_eq(output.status(), 0);
    return checks.Result.Ok;
  }

  /** Reads a fixture file and preserves I/O errors as test failures. */
  public function read(path: ref String) checks.Result<String> {
    var a = make_heap_allocator();
    return checks.Result.Ok(try std.test.expect_system(std.io.read_to_string(a, path)));
  }

  /** Writes a fixture file and preserves I/O errors as test failures. */
  public function write(path: ref String, value: ref String) checks.Result<void> {
    try std.test.expect_system_success(std.io.write_string(path, value));
    return checks.Result.Ok;
  }
}
