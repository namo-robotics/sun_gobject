using std;

/** Provides isolated fixtures and bounded commands for the native test suite. */
module checks {

  /** Owns a unique workspace scratch directory and removes it on scope exit. */
  public class Fixture {
    public var path: String;

    /** Creates a directory without changing the process working directory. */
    init() std.test.AssertionResult<void> {
      var a = make_heap_allocator();
      var command = try std.process.Command(a, "mktemp");
      try command.add_arg("-d");
      var pattern = try String(test_build.root());
      try pattern.append("/tmp/sun-tests.XXXXXX");
      try command.add_arg(pattern);
      var output = try std.test.expect_system(command.output());
      try std.test.assert_eq(output.status(), 0);
      var directory = try output.stdout().clone(a);
      directory.trim();
      this.path = directory;
    }

    /** Resolves a file beneath this fixture. */
    public method file(name: static_ptr<u8>) AllocationResult<String> {
      var a = make_heap_allocator();
      var result = try this.path.clone(a);
      try result.append("/");
      try result.append(name);
      return AllocationResult.Ok(result);
    }

    /** Removes nested fixture files even after an assertion fails. */
    deinit() {
      ignore_error(this.remove());
    }

    /** Removes the fixture while reporting allocation and process failures. */
    method remove() SystemResult<void> {
      var a = make_heap_allocator();
      var command = try std.process.Command(a, "rm");
      try command.add_arg("-rf");
      try command.add_arg("--");
      try command.add_arg(this.path);
      try command.status();
      return SystemResult.Ok;
    }
  }

  /** Runs a bounded shell command with fixture, build, compiler, and root arguments. */
  public function command(
    fixture: ref Fixture,
    script: static_ptr<u8>
  ) std.test.AssertionResult<std.process.Output> {
    var a = make_heap_allocator();
    var command = try std.process.Command(a, "timeout");
    try command.add_arg("30s");
    try command.add_arg("sh");
    try command.add_arg("-eu");
    try command.add_arg("-c");
    try command.add_arg(script);
    try command.add_arg("sun-tests");
    try command.add_arg(fixture.path);
    try command.add_arg(test_build.directory());
    try command.add_arg(test_build.compiler());
    try command.add_arg(test_build.root());
    return std.test.AssertionResult.Ok(try std.test.expect_system(command.output()));
  }

  /** Reports subprocess diagnostics before asserting its successful exit. */
  public function success(output: ref std.process.Output) std.test.AssertionResult<void> {
    if (output.status() != 0) {
      std.io.eprintln(output.stdout());
      std.io.eprintln(output.stderr());
    }
    try std.test.assert_eq(output.status(), 0);
    return std.test.AssertionResult.Ok;
  }

  /** Reads a fixture file and preserves I/O errors as test failures. */
  public function read(path: ref String) std.test.AssertionResult<String> {
    var a = make_heap_allocator();
    return std.test.AssertionResult.Ok(try std.test.expect_system(std.io.read_to_string(a, path)));
  }

  /** Writes a fixture file and preserves I/O errors as test failures. */
  public function write(path: ref String, value: ref String) std.test.AssertionResult<void> {
    try std.test.expect_system_success(std.io.write_string(path, value));
    return std.test.AssertionResult.Ok;
  }
}
