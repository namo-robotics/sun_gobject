using std;

/** Runs isolated main-thread GTK event-loop scenarios for the Sun test suite. */
module event_checks {

  /** Reports an invariant failure without terminating callback cleanup. */
  function expect(condition: bool, message: static_ptr<u8>) void throws {
    if (condition == false) {
      throw Error(1, message);
    }
    return;
  }

  /** Owns widgets and explicit state shared by each scenario's callbacks. */
  class State {
    var window: gtk.Window;
    var button: gtk.Button;
    var replacement: Option<gtk.Window> = Option.None;
    var target: Option<gtk.RegistrationId> = Option.None;
    var trace: String;
    var count: i32 = 0;
    var inside: bool = false;
    var mark: std.time.Instant;

    /** Creates an application window without requiring it to be displayed. */
    init(app: ref gtk.Application) throws {
      this.window = gtk.Window(app);
      var label = String("events");
      this.button = gtk.Button(label);
      this.window.set_child(this.button);
      this.trace = String("");
      this.mark = std.time.now();
    }
  }

  /** Fails if a cancelled or newly registered handler receives an old event. */
  function unexpected(state: ref State, context: ref gtk.EventContext<State>) void throws {
    throw Error(1, "Unexpected callback delivery");
  }

  /** Records one close after GTK has removed the window. */
  function closed(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(context.kind() == gtk.EventKind.Closed, "Wrong close event kind");
    expect(state.window.is_open() == false, "Close notification preceded removal");
    state.trace.append("D");
    return;
  }

  /** Cancels itself and the next queued handler, then emits a non-reentrant click. */
  function first(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(context.kind() == gtk.EventKind.Clicked, "Wrong click event kind");
    state.trace.append("A");
    state.inside = true;
    var own = context.registration();
    context.disconnect(own);
    context.disconnect(own);
    match state.target {
      Option.Some(id) => {
        context.disconnect(id);
      },
      Option.None => {}
    };
    state.button.click();
    expect(state.trace.equals_literal("A"), "Click dispatch was recursive");
    state.inside = false;
    return;
  }

  /** Records ordered surviving handlers and closes after the queued second click. */
  function third(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(state.inside == false, "Callback entered another callback");
    state.trace.append("C");
    state.count += 1;
    if (state.count == 2) {
      state.window.close();
    }
    return;
  }

  /** Checks handler ordering, cancellation of queued work, and independent polling. */
  function ordering() void throws {
    var id = String("org.sunlang.Events.Order");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var a = loop.on_clicked(state.button, first);
    state.target = Option.Some(loop.on_clicked(state.button, unexpected));
    // Dropping the returned ID must not disconnect a loop-owned registration.
    if (true) {
      var c = loop.on_clicked(state.button, third);
    }
    var d = loop.on_closed(state.window, closed);
    state.button.click();
    loop.run(state);
    expect(state.trace.equals_literal("ACCD"), "FIFO handler order or cancellation differs");
    expect(
      state.button.take_click() and state.button.take_click() and
        state.button.take_click() == false,
      "Polling stole registered events"
    );
    loop.disconnect(a);
    loop.disconnect(d);

    var operation_completed_12 = false;
    try {
      loop.after(0, unexpected);
      operation_completed_12 = true;
      throw Error(1, "Completed loop accepted registration");
    } catch (error: std.Error) {
      if (operation_completed_12) {
        throw;
      }
    }

    var operation_completed_11 = false;
    try {
      loop.run(state);
      operation_completed_11 = true;
      throw Error(1, "Completed loop ran twice");
    } catch (error: std.Error) {
      if (operation_completed_11) {
        throw;
      }
    }

    return;
  }

  /** Delivers only the future click produced by a deferred timer. */
  function added(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.trace.append("N");
    state.window.close();
    return;
  }

  /** Emits the future click after registration changes have been committed. */
  function emit_later(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(state.trace.equals_literal("S"), "Deferred timer ran inside registration callback");
    state.button.click();
    return;
  }

  /** Stages a new handler and timers, cancelling both itself and a new timer. */
  function stage(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.trace.append("S");
    var added_id = context.on_clicked(state.button, added);
    var cancelled = context.after(0, unexpected);
    context.disconnect(cancelled);
    var timer = context.after(0, emit_later);
    var own = context.registration();
    context.disconnect(own);
    state.button.click();
    return;
  }

  /** Checks that additions observe future events and same-callback cancellation works. */
  function deferred() void throws {
    var id = String("org.sunlang.Events.Deferred");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var handler = loop.on_clicked(state.button, stage);
    state.button.click();
    loop.run(state);
    expect(state.trace.equals_literal("SN"), "Deferred registrations observed an old event");
    return;
  }

  /** Finishes after a timer has been cancelled from its own callback. */
  function stop_timer(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(state.count == 2, "Repeating timer delivered after cancellation");
    state.window.close();
    return;
  }

  /** Sleeps once and checks the next interval starts after callback completion. */
  function tick(state: ref State, context: ref gtk.EventContext<State>) void throws {
    expect(context.kind() == gtk.EventKind.Timer, "Wrong timer event kind");
    state.count += 1;
    if (state.count == 1) {
      std.time.sleep(std.time.create_duration_millis(35));
      state.mark = std.time.now();
    } else {
      expect(
        state.mark.elapsed().as_millis() >= 10,
        "Repeating timer caught up instead of delaying"
      );
      var own = context.registration();
      context.disconnect(own);
      var stop = context.after(30, stop_timer);
    }
    return;
  }

  /** Checks positive intervals, pre-delivery cancellation, and non-catch-up repetition. */
  function timers() void throws {
    var id = String("org.sunlang.Events.Timers");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);

    var operation_completed_10 = false;
    try {
      loop.every(0, unexpected);
      operation_completed_10 = true;
      throw Error(1, "Zero repeating interval accepted");
    } catch (error: std.Error) {
      if (operation_completed_10) {
        throw;
      }
    }

    var cancel = loop.after(0, unexpected);
    loop.disconnect(cancel);
    var repeated = loop.every(15, tick);
    loop.run(state);
    expect(state.count == 2, "Timer count differs");
    return;
  }

  /** Requests exit without closing its window or dispatching later queued work. */
  function quit(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.count += 1;
    context.quit();
    return;
  }

  /** Returns a callback failure after staging work that must be discarded. */
  function fail(state: ref State, context: ref gtk.EventContext<State>) void throws {
    var timer = context.after(0, unexpected);
    throw Error(77, "expected callback failure");
  }

  /** Checks explicit quit, error propagation, and source cleanup after completion. */
  function completion() void throws {
    var id = String("org.sunlang.Events.Completion");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var q = loop.on_clicked(state.button, quit);
    var later = loop.on_clicked(state.button, unexpected);
    state.button.click();
    loop.run(state);
    expect(
      state.count == 1 and state.window.is_open(),
      "Quit did not stop after current callback"
    );
    state.button.click();
    var id2 = String("org.sunlang.Events.Failure");
    var app2 = gtk.Application(id2);
    var state2 = State(app2);
    var loop2 = gtk.EventLoop<State>(app2);
    var f = loop2.on_clicked(state2.button, fail);
    state2.button.click();

    var operation_completed_9 = false;
    try {
      loop2.run(state2);
      operation_completed_9 = true;
      throw Error(1, "Callback error was swallowed");
    } catch (error: std.Error) {
      if (operation_completed_9) {
        throw;
      }
      expect(error.code() == 77, "Callback error was replaced");
    }

    state2.button.click();
    return;
  }

  /** Creates and registers a replacement window from a close callback. */
  function replace(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.count += 1;
    var window = context.create_window();
    var close = context.on_closed(window, replacement_closed);
    state.replacement = Option.Some(window);
    var timer = context.after(0, close_replacement);
    return;
  }

  /** Closes the replacement after its close notification has been registered. */
  function close_replacement(state: ref State, context: ref gtk.EventContext<State>) void throws {
    match state.replacement {
      Option.Some(window) => {
        window.close();
      },
      Option.None => {
        throw Error(1, "Missing replacement window");
      }
    };
    return;
  }

  /** Records the final close; pending timers must not keep the loop alive. */
  function replacement_closed(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.count += 1;
    var unused = context.every(60000, unexpected);
    return;
  }

  /** Checks close delivery before automatic exit and replacement-window continuation. */
  function windows() void throws {
    var id = String("org.sunlang.Events.Windows");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var close = loop.on_closed(state.window, replace);
    state.window.close();
    loop.run(state);
    expect(state.count == 2, "Close callbacks or replacement window were skipped");
    return;
  }

  /** Rejects nested dispatch while allowing the outer loop to complete. */
  function nested(state: ref State, context: ref gtk.EventContext<State>) void throws {
    var id = String("org.sunlang.Events.Inner");
    var app = gtk.Application(id);
    var inner = State(app);
    var loop = gtk.EventLoop<State>(app);

    var operation_completed_8 = false;
    try {
      loop.run(inner);
      operation_completed_8 = true;
      throw Error(1, "Nested dispatch was accepted");
    } catch (error: std.Error) {
      if (operation_completed_8) {
        throw;
      }
    }

    state.count += 1;
    context.quit();
    return;
  }

  /** Checks loop identity and protects the native context from recursive dispatch. */
  function identities() void throws {
    var id = String("org.sunlang.Events.Outer");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var token = loop.on_clicked(state.button, nested);
    var other_id = String("org.sunlang.Events.Other");
    var other_app = gtk.Application(other_id);
    var other = gtk.EventLoop<State>(other_app);

    var operation_completed_7 = false;
    try {
      other.disconnect(token);
      operation_completed_7 = true;
      throw Error(1, "Foreign registration accepted");
    } catch (error: std.Error) {
      if (operation_completed_7) {
        throw;
      }
    }

    state.button.click();
    loop.run(state);
    expect(state.count == 1, "Outer dispatch failed after nested rejection");
    return;
  }

  /** Counts events from an emitter whose original Sun wrapper has been destroyed. */
  function retained(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.count += 1;
    context.quit();
    return;
  }

  /** Checks registration ownership outlives the temporary widget wrapper. */
  function ownership() void throws {
    var id = String("org.sunlang.Events.Ownership");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    if (true) {
      var label = String("temporary");
      var button = gtk.Button(label);
      var token = loop.on_clicked(button, retained);
      button.click();
    }
    loop.run(state);
    expect(state.count == 1, "Emitter did not survive wrapper destruction");
    return;
  }

  /** Marks that a GLib timer was serviced during a long callback-generated click chain. */
  function serviced(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.inside = true;
    return;
  }

  /** Keeps generating events until the bounded batch gives GTK a turn. */
  function chain(state: ref State, context: ref gtk.EventContext<State>) void throws {
    state.count += 1;
    if (state.inside) {
      context.quit();
    } else if (state.count > 128) {
      throw Error(1, "GTK starved behind queued clicks");
    } else {
      state.button.click();
    }
    return;
  }

  /** Checks the dispatcher services GTK between bounded event batches. */
  function fairness() void throws {
    var id = String("org.sunlang.Events.Fairness");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var click = loop.on_clicked(state.button, chain);
    var timer = loop.after(0, serviced);
    state.button.click();
    loop.run(state);
    expect(
      state.inside and state.count >= 64 and state.count <= 128,
      "Dispatch batch policy differs"
    );
    return;
  }

  /** Attempts loop mutation on a worker; the main-thread guard must terminate first. */
  function worker(loop: gtk.EventLoop<State>) i32 {
    try {
      loop.after(0, unexpected);
    } catch {}
    return 0;
  }

  /** Moves a loop to a worker to exercise the loop-specific thread guard. */
  function worker_thread() void throws {
    var id = String("org.sunlang.Events.Worker");
    var app = gtk.Application(id);
    var loop = gtk.EventLoop<State>(app);
    var thread = std.thread.spawn(worker, loop);
    var status = thread.join();
    throw Error(1, "Worker thread was allowed to mutate the loop");
  }

  /** Attempts manual native dispatch while a callback is active. */
  function manual(state: ref State, context: ref gtk.EventContext<State>) void throws {
    var id = String("org.sunlang.Events.Manual");
    var app = gtk.Application(id);
    app.iterate(false);
    throw Error(1, "Manual iteration was allowed during callback dispatch");
  }

  /** Exercises the fail-fast guard against legacy manual iteration from callbacks. */
  function manual_iteration() void throws {
    var id = String("org.sunlang.Events.ManualOuter");
    var app = gtk.Application(id);
    var state = State(app);
    var loop = gtk.EventLoop<State>(app);
    var token = loop.on_clicked(state.button, manual);
    state.button.click();
    return loop.run(state);
  }

  /** Observes finalization without retaining an object. */
  extern "C" function sg_test_watch_object(object: raw_ptr<u8>) void;

  /** Counts objects whose native references have not yet been released. */
  extern "C" function sg_test_watched_objects() i32;

  /** Records existing application references before loop construction. */
  extern "C" function sg_test_hold_application(application: raw_ptr<u8>) void;

  /** Checks loop reference balance independently of GTK registration ownership. */
  extern "C" function sg_test_application_balanced() i32;

  /** Verifies native controlled setters preserve the editable cursor and selection. */
  extern "C" function sg_test_entry_selection() i32;

  /** Checks cleanup on success, callback failure, and dropping an unrun loop. */
  function cleanup() void throws {
    for (var mode: i32 = 0; mode < 3; mode += 1) {
      if (true) {
        var id = String("org.sunlang.Events.Cleanup");
        id.append(mode);
        var app = gtk.Application(id);
        expect(
          unsafe { sg_test_entry_selection(); } != 0,
          "Unchanged text reset cursor or selection"
        );
        unsafe { sg_test_hold_application(app.raw_handle()); };
        var state = State(app);
        unsafe {
          sg_test_watch_object(state.window.raw_handle());
          sg_test_watch_object(state.button.raw_handle());
        };
        var loop = gtk.EventLoop<State>(app);
        var timer = loop.every(60000, unexpected);
        if (mode == 0) {
          var token = loop.on_clicked(state.button, quit);
          state.button.click();
          loop.run(state);
        } else if (mode == 1) {
          var token = loop.on_clicked(state.button, fail);
          state.button.click();

          var operation_completed_6 = false;
          try {
            loop.run(state);
            operation_completed_6 = true;
            throw Error(1, "Cleanup error callback succeeded");
          } catch (error: std.Error) {
            if (operation_completed_6) {
              throw;
            }
          }
        } else {
          var token = loop.on_clicked(state.button, unexpected);
          state.button.click();
        }
      }
      expect(
        unsafe { sg_test_watched_objects(); } == 0,
        "Loop cleanup retained native widgets"
      );
      expect(
        unsafe { sg_test_application_balanced(); } != 0,
        "Loop cleanup retained its application reference"
      );
    }
    return;
  }

  /** Checks one FIFO delivery without exposing native pointers or application state. */
  function delivery(
    queue: ref gtk.EventQueue,
    expected: const ref gtk.RegistrationId,
    kind: gtk.EventKind
  ) void throws {
    match queue.next() {
      Option.Some(event) => {
        var id = event.registration();
        expect(
          id.equals(expected) and event.kind() == kind,
          "Native queue delivery order or kind differs"
        );
      },
      Option.None => {
        throw Error(1, "Native queue lost a delivery");
      }
    };
    return;
  }

  /** Exercises state-free dispatch, cancellation, retained emitters, and windowless timers. */
  function native_queue() void throws {
    if (true) {
      var id = String("org.sunlang.Events.Queue");
      var app = gtk.Application(id);
      unsafe { sg_test_hold_application(app.raw_handle()); };
      if (true) {
        var window = gtk.Window(app);
        var label = String("queued");
        var first = gtk.Button(label);
        var second = gtk.Button(label);
        var box = gtk.Box(gtk.Orientation.Vertical, 8);
        window.set_box(box);
        box.place_first(first);
        box.place_after(second, first);
        expect(
          box.is_first(first) and box.follows(second, first),
          "Checked box placement differs"
        );

        var operation_completed_5 = false;
        try {
          window.set_child(second);
          operation_completed_5 = true;
          throw Error(1, "Parented button accepted by window");
        } catch (error: std.Error) {
          if (operation_completed_5) {
            throw;
          }
        }

        var other_box = gtk.Box(gtk.Orientation.Horizontal, 0);

        var operation_completed_4 = false;
        try {
          other_box.place_first(first);
          operation_completed_4 = true;
          throw Error(1, "Foreign parent accepted by box");
        } catch (error: std.Error) {
          if (operation_completed_4) {
            throw;
          }
        }

        unsafe {
          sg_test_watch_object(first.raw_handle());
          sg_test_watch_object(second.raw_handle());
          sg_test_watch_object(box.raw_handle());
          sg_test_watch_object(window.raw_handle());
        };
        var queue = gtk.EventQueue(app);

        var operation_completed_3 = false;
        try {
          gtk.EventQueue(app);
          operation_completed_3 = true;
          throw Error(1, "Nested queue acquired native dispatch");
        } catch (error: std.Error) {
          if (operation_completed_3) {
            throw;
          }
        }

        var a = queue.on_clicked(first);
        var b = queue.on_clicked(second);
        second.click();
        first.click();
        second.click();
        delivery(queue, b, gtk.EventKind.Clicked);
        delivery(queue, a, gtk.EventKind.Clicked);
        delivery(queue, b, gtk.EventKind.Clicked);
        first.click();
        queue.disconnect(a);
        queue.disconnect(a);
        match queue.next() {
          Option.Some(_) => {
            throw Error(1, "Canceled native event was delivered");
          },
          Option.None => {}
        };
        var other_id = String("org.sunlang.Events.QueueForeign");
        var other_app = gtk.Application(other_id);
        var legacy = gtk.EventLoop<i32>(other_app);
        var foreign = legacy.after(60000, unused_queue_callback);

        var operation_completed_2 = false;
        try {
          queue.disconnect(foreign);
          operation_completed_2 = true;
          throw Error(1, "Foreign queue identity accepted");
        } catch (error: std.Error) {
          if (operation_completed_2) {
            throw;
          }
        }

        if (true) {
          var temporary = gtk.Button(label);
          var token = queue.on_clicked(temporary);
          temporary.click();
        }
        match queue.next() {
          Option.Some(event) => {
            var token = event.registration();
            queue.disconnect(token);
          },
          Option.None => {
            throw Error(1, "Queue did not retain emitter");
          }
        };
        var close_id = queue.on_closed(window);
        window.close();
        delivery(queue, close_id, gtk.EventKind.Closed);
        var timer = queue.after(0);
        var received = false;
        while (received == false) {
          queue.iterate(true);
          match queue.next() {
            Option.Some(event) => {
              var token = event.registration();
              expect(
                token.equals(timer) and event.kind() == gtk.EventKind.Timer,
                "Windowless timer was lost"
              );
              received = true;
            },
            Option.None => {}
          };
        }
        queue.disconnect(timer);
        expect(box.remove(second), "Box could not remove owned child");
        second.set_label(label);
        expect(box.remove(second) == false, "Repeated child removal changed ownership");
        // Drop with a pending click and live timer to exercise resource cleanup.
        second.click();
        var pending = queue.after(60000);
      }
      expect(
        unsafe { sg_test_watched_objects(); } == 0,
        "Native queue retained widgets after destruction"
      );
      // Destruction must release exclusive dispatch for the next consumer.
      if (true) {
        var next = gtk.EventQueue(app);
      }
    }
    expect(
      unsafe { sg_test_application_balanced(); } != 0,
      "Native queue retained its application"
    );
    return;
  }

  /** Supplies a callback type only for the foreign-identity rejection check. */
  function unused_queue_callback(state: ref i32, context: ref gtk.EventContext<i32>) void throws {
    return;
  }

  /** Selects one isolated scenario by its test-facing name. */
  public function run(name: const ref String) void throws {
    if (name.equals_literal("native_queue")) {
      return native_queue();
    }
    if (name.equals_literal("cleanup")) {
      return cleanup();
    }
    if (name.equals_literal("ordering")) {
      return ordering();
    }
    if (name.equals_literal("deferred")) {
      return deferred();
    }
    if (name.equals_literal("timers")) {
      return timers();
    }
    if (name.equals_literal("completion")) {
      return completion();
    }
    if (name.equals_literal("windows")) {
      return windows();
    }
    if (name.equals_literal("identities")) {
      return identities();
    }
    if (name.equals_literal("ownership")) {
      return ownership();
    }
    if (name.equals_literal("fairness")) {
      return fairness();
    }
    if (name.equals_literal("worker")) {
      return worker_thread();
    }
    if (name.equals_literal("manual")) {
      return manual_iteration();
    }
    throw Error(1, "Unknown event-loop scenario");
  }
}

/** Runs one main-thread scenario and reports failures to its parent Sun test. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  if (args.size() != 2) {
    return 2;
  }

  var operation_completed_1 = false;
  try {
    event_checks.run(args[1]);
    operation_completed_1 = true;
    std.io.println("Event scenario passed");
    return 0;
  } catch (error: std.Error) {
    if (operation_completed_1) {
      throw;
    }
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_gobject.moon",
    "sun_gtk.moon"
  ]
}
