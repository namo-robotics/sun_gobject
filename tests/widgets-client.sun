using std;

/** Waits briefly for the GTK frame clock during bounded native acceptance checks. */
extern "C" function g_usleep(microseconds: u64) void;

/** Verifies weighted grid allocation and captured editable values through checked APIs. */
function declarative_widgets(app: ref gtk.Application) void throws {
  var window = gtk.Window(app);
  var grid = gtk.Widget(3);
  var left = gtk.Widget(5);
  var right = gtk.Widget(5);
  grid.track(true, 0, 0, true);
  grid.track(true, 2, 1, false);
  grid.track(true, 2, 2, false);
  left.properties(true, true, 0, -1, -1, 0, 0, true, false, 0);
  right.properties(true, true, 0, -1, -1, 0, 0, true, false, 0);
  grid.place_first(left, 0, 0, 1, 1);
  grid.place_after(right, left, 0, 1, 1, 1);
  window.set_widget(grid);
  window.set_default_size(300, 100);
  window.present();
  for (var i: i64 = 0; i < 100 and left.extent(true) == 0; i += 1) {
    app.iterate(false);
    unsafe { g_usleep(10000); };
  }
  if (left.extent(true) <= 0 or right.extent(true) < left.extent(true) * 2 - 2 or
    right.extent(true) > left.extent(true) * 2 + 2) {
    throw Error(1, "Weighted tracks did not share remaining space");
  }

  var operation_completed_10 = false;
  try {
    grid.place_first(grid, 0, 0, 1, 1);
    operation_completed_10 = true;
    throw Error(1, "Grid accepted self parenting");
  } catch (error: std.Error) {
    if (operation_completed_10) {
      throw;
    }
  }

  var entry = gtk.Widget(7);
  var select = gtk.Widget(9);
  var queue = gtk.EventQueue(app);
  var entry_id = queue.on_widget(entry);
  var select_id = queue.on_widget(select);
  var text = String("alpha");
  entry.edit(text, 0);
  text = String("beta");
  entry.edit(text, 0);
  var labels = String("First");
  var key = String("stable-first");
  select.clear_options();
  select.add_option(labels, key);
  labels = String("Second");
  key = String("stable-second");
  select.add_option(labels, key);
  select.set_value(0);
  select.edit(text, 1);
  select.clear_options();
  labels = String("Replacement");
  key = String("replacement");
  select.add_option(labels, key);
  for (var i: i64 = 0; i < 3; i += 1) {
    match queue.next() {
      Option.Some(event) => {
        var expected = String(i == 0 ? "alpha" : (i == 1 ? "beta" : "stable-second"));

        if (not event.text.equals(expected)) {
          throw Error(1, "Native edit snapshot was changed before delivery");
        }
      },
      Option.None => {
        throw Error(1, "Native edit snapshot was lost");
      }
    };
  }
  text = String("programmatic");
  entry.set_text(text);
  match queue.next() {
    Option.None => {},
    Option.Some(_) => {
      throw Error(1, "Controlled setter emitted a user edit");
    }
  };
  queue.disconnect(entry_id);
  queue.disconnect(select_id);
  window.close();
  return;
}

/** Checks ownership, validation, composition, drawing, and chooser cleanup using safe APIs. */
function run() void throws {
  var id = String("org.sunlang.CheckedWidgetsTest");
  var app = gtk.Application(id);
  var window = gtk.Window(app);
  var root = gtk.Box(gtk.Orientation.Vertical, 8);
  var toolbar = gtk.Box(gtk.Orientation.Horizontal, 8);
  var text = String("Ready");
  var label = gtk.Label(text);
  var area = gtk.DrawingArea();
  toolbar.append(label);
  root.append(toolbar);
  root.append(area);
  area.set_vexpand(true);

  var operation_completed_9 = false;
  try {
    root.append(label);
    operation_completed_9 = true;
    throw Error(1, "Reparenting a label was accepted");
  } catch (error: std.Error) {
    if (operation_completed_9) {
      throw;
    }
  }

  var operation_completed_8 = false;
  try {
    toolbar.append(root);
    operation_completed_8 = true;
    throw Error(1, "A parenting cycle was accepted");
  } catch (error: std.Error) {
    if (operation_completed_8) {
      throw;
    }
  }

  var invalid = String("bad");
  invalid.append_char(0);

  var operation_completed_7 = false;
  try {
    label.set_text(invalid);
    operation_completed_7 = true;
    throw Error(1, "Embedded NUL was accepted");
  } catch (error: std.Error) {
    if (operation_completed_7) {
      throw;
    }
  }

  var unchanged = label.text();
  if (unchanged.equals_literal("Ready") == false) {
    throw Error(1, "Invalid text changed the label");
  }
  var malformed = String("<svg");

  var operation_completed_6 = false;
  try {
    svg.Document(malformed);
    operation_completed_6 = true;
    throw Error(1, "Malformed SVG was accepted");
  } catch (error: std.Error) {
    if (operation_completed_6) {
      throw;
    }
  }

  // The area must retain its document after the source wrapper leaves scope.
  if (true) {
    var content = String(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\"><circle cx=\"100\" cy=\"50\" r=\"30\"/></svg>"
    );

    var document = svg.Document(content);
    area.set_document(document);
  }
  window.set_box(root);
  window.set_default_size(400, 300);
  window.present();
  for (var i: i64 = 0; i < 200 and area.rendered() == false; i += 1) {
    app.iterate(false);
    unsafe { g_usleep(10000); };
  }
  if (area.rendered() == false or area.render_failed()) {
    throw Error(1, "Retained document did not render");
  }
  std.io.eprintln("Drawing rendered; checking save dialog");
  var chooser = gtk.SaveDialog();
  var title = String("Save test");
  var filename = String("test.svg");
  chooser.show(window, title, filename);
  std.io.eprintln("Save dialog shown; checking cancellation");

  var operation_completed_5 = false;
  try {
    chooser.show(window, title, filename);
    operation_completed_5 = true;
    throw Error(1, "Concurrent save request was accepted");
  } catch (error: std.Error) {
    if (operation_completed_5) {
      throw;
    }
  }

  chooser.cancel();
  chooser.cancel();
  if (chooser.is_open()) {
    throw Error(1, "Cancelled chooser remained open");
  }
  match chooser.take_path() {
    Option.Some(_) => {
      throw Error(1, "Cancelled chooser returned a path");
    },
    Option.None => {}
  };
  std.io.eprintln("Save dialog cancelled; checking open dialog");
  var open = gtk.OpenDialog();
  open.show(window, title);
  std.io.eprintln("Open dialog shown; checking cancellation");

  var operation_completed_4 = false;
  try {
    open.show(window, title);
    operation_completed_4 = true;
    throw Error(1, "Concurrent open request was accepted");
  } catch (error: std.Error) {
    if (operation_completed_4) {
      throw;
    }
  }

  open.cancel();
  open.cancel();
  if (open.is_open()) {
    throw Error(1, "Cancelled open chooser remained open");
  }
  match open.take_path() {
    Option.Some(_) => {
      throw Error(1, "Cancelled open chooser returned a path");
    },
    Option.None => {}
  };
  window.close();

  var operation_completed_3 = false;
  try {
    open.show(window, title);
    operation_completed_3 = true;
    throw Error(1, "Closed parent accepted an open request");
  } catch (error: std.Error) {
    if (operation_completed_3) {
      throw;
    }
  }

  var operation_completed_2 = false;
  try {
    chooser.show(window, title, filename);
    operation_completed_2 = true;
    throw Error(1, "Closed parent accepted a save request");
  } catch (error: std.Error) {
    if (operation_completed_2) {
      throw;
    }
  }

  std.io.eprintln("Dialogs closed; checking declarative widgets");
  declarative_widgets(app);
  kept_media_sections(app);
  std.io.println("Checked drawing widgets passed");
  return;
}

/** Exercises shared-boundary drags and rejects malformed kept-section updates. */
function kept_media_sections(app: ref gtk.Application) void throws {
  var window = gtk.Window(app);
  var media = gtk.Widget(10);
  var path = String("");
  media.media(path, 4000000, 0, 2000000, 0);
  var ranges = String("1,0,2000000;2,2000000,4000000");
  media.media_ranges(ranges, 1);
  var invalid = String("1,0,3000000;2,2000000,4000000");

  var operation_completed_1 = false;
  try {
    media.media_ranges(invalid, 1);
    operation_completed_1 = true;
    throw Error(1, "Overlapping media ranges accepted");
  } catch (error: std.Error) {
    if (operation_completed_1) {
      throw;
    }
  }

  window.set_widget(media);
  window.set_default_size(800, 500);
  window.present();
  for (var i: i64 = 0; i < 50; i += 1) {
    app.iterate(false);
    unsafe { g_usleep(10000); };
  }
  var queue = gtk.EventQueue(app);
  var registration = queue.on_widget(media);
  media.drag_media(0.5, 0.75);
  var edited = false;
  while (true) {
    match queue.next() {
      Option.Some(event) => {
        edited = edited or event.text.equals_literal("3000000:4000000:3000000:2");
      },
      Option.None => {
        break;
      }
    };
  }
  if (not edited) {
    throw Error(1, "Shared trim boundary did not select the right start handle");
  }
  queue.disconnect(registration);
  window.close();
  return;
}

/** Reports native wrapper acceptance failures to the parent test process. */
function main() i32 throws {
  try {
    run();
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_gobject.moon",
    "sun_gtk.moon"
  ]
}
