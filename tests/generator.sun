using std;

/** Checks XML validation and GIR generation through the public command line. */
module generator_tests {

  /** Generates fixtures, preferring any locally modified input files. */
  function generate(fixture: ref checks.Fixture) std.test.AssertionResult<std.process.Output> {
    return checks.command(
      fixture,
      "selection=\"$4/tests/fixtures/selection.xml\"; if [ -f \"$1/selection.xml\" ]; then selection=\"$1/selection.xml\"; fi; exec \"$2/sun_gir\" --selection \"$selection\" --gir-dir \"$1\" --gir-dir \"$4/tests/fixtures\" --output-dir \"$1\" --target x86_64-linux-gnu --sun-revision fixture --generator-revision fixture"
    );
  }

  /** Reads an input fixture from the repository. */
  function input(name: static_ptr<u8>) std.test.AssertionResult<String> {
    var path = try String(test_build.root());
    try path.append("/tests/fixtures/");
    try path.append(name);
    return checks.read(path);
  }

  /** Checks XML acceptance and numeric line and column diagnostics on rejection. */
  function xml(
    fixture: ref checks.Fixture,
    content: ref String,
    accepted: bool
  ) std.test.AssertionResult<void> {
    var path = try fixture.file("input.xml");
    try checks.write(path, content);
    var output = try checks.command(fixture, "exec \"$2/sun_gir\" --check-xml \"$1/input.xml\"");
    try std.test.assert_eq(output.status() == 0, accepted);
    if (accepted == false) {
      var diagnostic: ref String = output.stderr();
      var start = match diagnostic.find("input.xml:") {
        Option.Some(index) => index,
        Option.None => -1
      };
      try std.test.assert(start >= 0, "diagnostic includes the source filename");
      var offset = start + 10;
      for (var field: i32 = 0; field < 2; field += 1) {
        var digits: i64 = 0;
        while (offset < diagnostic.length()) {
          var byte = try diagnostic.at(offset);
          if (byte < b'0' or byte > b'9') {
            break;
          }
          digits += 1;
          offset += 1;
        }
        try std.test.assert(digits > 0, "diagnostic includes a numeric source location");
        try std.test.assert_eq(try diagnostic.at(offset), b':');
        offset += 1;
      }
    }
    return std.test.AssertionResult.Ok;
  }

  /** Accepts text, entity references, declarations, CDATA, and Unicode. */
  test_function valid_xml() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var content = try input("xml-valid.xml");
    try xml(fixture, content, true);
    var unicode = try String("<r a=\"&#x1F600;&#65;\">é &amp; <![CDATA[<>]]></r>");

    try xml(fixture, unicode, true);
  }

  /** Rejects malformed structure, entities, encodings, and unsafe declarations. */
  test_function malformed_xml() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var a = make_heap_allocator();
    var cases = try Vec<String>(a, 16);
    try cases.push(try String("<r>"));
    try cases.push(try String("<r></wrong>"));

    try cases.push(try String("<r/><s/>"));
    try cases.push(try String("<r a=\"1\"a=\"2\"/>"));

    try cases.push(try String("<r a=\"1\" a=\"2\"/>"));

    try cases.push(try String("<r>&unknown;</r>"));

    try cases.push(try String("<r>&#0;</r>"));

    try cases.push(try String("<r>&#xD800;</r>"));

    try cases.push(try String("<r>&#99999999;</r>"));

    try cases.push(
      try String("<!DOCTYPE r SYSTEM \"file:///etc/passwd\"><r/>")
    );

    try cases.push(try String("<r><!-- bad -- comment --></r>"));

    try cases.push(try String("<r>]]></r>"));

    try cases.push(try String("<r a=\"<\"/>"));

    var overlong = try String("<r>");
    try overlong.append_char(192);
    try overlong.append_char(128);
    try overlong.append("</r>");
    try cases.push(overlong);
    var truncated = try String("<r>");
    try truncated.append_char(240);
    try truncated.append_char(144);
    try truncated.append("</r>");
    try cases.push(truncated);
    var nul = try String("<r>");
    try nul.append_char(0);
    try nul.append("</r>");
    try cases.push(nul);
    for (var content: ref String in cases) {
      try xml(fixture, content, false);
    }
  }

  /** Verifies the source golden, compilation, metadata, hashes, and repeatability. */
  test_function generation() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var result = try generate(fixture);
    try checks.success(result);
    var path = try fixture.file("tiny.sun");
    var source = try checks.read(path);
    var golden = try input("tiny.expected.sun");
    try std.test.assert_eq(source, golden);
    var compiled = try checks.command(
      fixture,
      "\"$3\" --emit-moon -o \"$1/tiny.moon\" \"$1/tiny.sun\""
    );
    try checks.success(compiled);
    var snapshot_allocator = make_heap_allocator();
    var entries = try std.test.expect_system(std.io.read_dir(snapshot_allocator, fixture.path));
    var contents = try Vec<String>(snapshot_allocator, entries.size());
    for (var entry: ref std.io.DirEntry in entries) {
      var file_path = try fixture.path.clone(snapshot_allocator);
      try file_path.append("/");
      try file_path.append(entry.name());
      try contents.push(try checks.read(file_path));
    }
    var again = try generate(fixture);
    try checks.success(again);
    var after = try std.test.expect_system(std.io.read_dir(snapshot_allocator, fixture.path));
    try std.test.assert_eq(after.size(), entries.size());
    for (var i: i64 = 0; i < entries.size(); i += 1) {
      var file_path = try fixture.path.clone(snapshot_allocator);
      try file_path.append("/");
      try file_path.append((try entries.get(i)).name());
      var content = try checks.read(file_path);
      try std.test.assert_eq(try contents.get(i), content);
    }
    var a = make_heap_allocator();
    var model_path = try fixture.file("gir-model.json");
    var model = try std.json.parse_json(a, try checks.read(model_path));
    var nodes: ref std.json.Json = try (try model.at(0)).get("nodes");
    var parent_found = false;
    for (var i: i64 = 0; i < nodes.len(); i += 1) {
      var attrs: ref std.json.Json = try (try nodes.at(i)).get("attributes");
      if (attrs.has("parent")) {
        if ((try (try attrs.get("parent")).as_string()).equals_literal("GObject.Object")) {
          parent_found = true;
        }
      }
    }
    try std.test.assert(parent_found, "inheritance metadata retained");
    var provenance_path = try fixture.file("provenance.json");
    var provenance = try std.json.parse_json(a, try checks.read(provenance_path));
    try std.test.assert_eq(
      (try (try (try provenance.get("gir")).get("Tiny-1.0")).as_string()).length(),
      64
    );
    var coverage_path = try fixture.file("coverage.tsv");
    var coverage = try checks.read(coverage_path);
    try std.test.assert(coverage.contains("tiny_unsupported\tunselected"));
  }

  /** Rejects unsupported selections before replacing previous generated sources. */
  test_function unsupported_selected_preserves_output() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var result = try generate(fixture);
    try checks.success(result);
    var path = try fixture.file("tiny.sun");
    var before = try checks.read(path);
    var selection = try input("selection.xml");
    try selection.replace("tiny_increment", "tiny_unsupported");
    var selected = try fixture.file("selection.xml");
    try checks.write(selected, selection);
    var rejected = try generate(fixture);
    try std.test.assert_ne(rejected.status(), 0);
    try std.test.assert(rejected.stderr().contains("unsupported selected type"));
    var after = try checks.read(path);
    try std.test.assert_eq(before, after);
  }

  /** Resolves dependency enum ABI and retains callback and ownership annotations. */
  test_function recursive_dependency() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var source = try input("Tiny-1.0.gir");
    try source.replace(
      "<namespace name=\"Tiny\"",
      "<include name=\"TinyDep\" version=\"1.0\"/><namespace name=\"Tiny\""
    );
    try source.replace(
      "name=\"gint\" c:type=\"gint\"",
      "name=\"TinyDep.Flags\" c:type=\"TinyFlags\""
    );
    try source.replace(
      "name=\"value\" transfer-ownership=\"none\"",
      "name=\"value\" transfer-ownership=\"full\" nullable=\"1\" scope=\"notified\" closure=\"1\" destroy=\"2\""
    );
    var gir = try fixture.file("Tiny-1.0.gir");
    try checks.write(gir, source);
    var result = try generate(fixture);
    try checks.success(result);
    var path = try fixture.file("tiny.sun");
    var generated = try checks.read(path);
    try std.test.assert(generated.contains("tiny_increment(arg0: u32) u32;"));
    var a = make_heap_allocator();
    var model_path = try fixture.file("gir-model.json");
    var model = try std.json.parse_json(a, try checks.read(model_path));
    try std.test.assert_eq(model.len(), 2);
    var nodes: ref std.json.Json = try (try model.at(0)).get("nodes");
    var found = false;
    for (var i: i64 = 0; i < nodes.len(); i += 1) {
      var node: ref std.json.Json = try nodes.at(i);
      var parameter = false;
      if (true) {
        parameter = (try (try node.get("tag")).as_string()).equals_literal("parameter");
      }
      if (parameter and found == false) {
        var attrs: ref std.json.Json = try node.get("attributes");
        try std.test.assert(
          (try (try attrs.get("transfer-ownership")).as_string()).equals_literal("full")
        );
        try std.test.assert((try (try attrs.get("nullable")).as_string()).equals_literal("1"));
        try std.test.assert((try (try attrs.get("scope")).as_string()).equals_literal("notified"));
        try std.test.assert((try (try attrs.get("closure")).as_string()).equals_literal("1"));
        try std.test.assert((try (try attrs.get("destroy")).as_string()).equals_literal("2"));
        found = true;
      }
    }
    try std.test.assert(found, "parameter metadata retained");
  }

  /** Resolves namespace URIs and rejects unbound or duplicate expanded names. */
  test_function namespace_prefixes() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var unbound = try String("<r><missing:child/></r>");
    try xml(fixture, unbound, false);
    var duplicate = try String("<r xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:x=\"1\" b:x=\"2\"/>");

    try xml(fixture, duplicate, false);
    var bom = try String("");
    try bom.append_char(239);
    try bom.append_char(187);
    try bom.append_char(191);
    try bom.append("<r>text\r\ntext</r>");
    try xml(fixture, bom, true);
    var source = try input("Tiny-1.0.gir");
    try source.replace("xmlns:c=", "xmlns:native=");
    try source.replace("c:", "native:");
    var gir = try fixture.file("Tiny-1.0.gir");
    try checks.write(gir, source);
    var result = try generate(fixture);
    try checks.success(result);
    var path = try fixture.file("tiny.sun");
    var generated = try checks.read(path);
    var golden = try input("tiny.expected.sun");
    try std.test.assert_eq(generated, golden);
  }

  /** Rejects a GIR file whose declared version differs from the requested name. */
  test_function dependency_version_mismatch() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var source = try input("Tiny-1.0.gir");
    try source.replace("name=\"Tiny\" version=\"1.0\"", "name=\"Tiny\" version=\"2.0\"");
    var gir = try fixture.file("Tiny-1.0.gir");
    try checks.write(gir, source);
    var result = try generate(fixture);
    try std.test.assert_ne(result.status(), 0);
    try std.test.assert(result.stderr().contains("namespace/version mismatch"));
  }

  /** Rejects a namespace version absent from the search paths. */
  test_function missing_dependency() std.test.AssertionResult<void> {
    var fixture = try checks.Fixture();
    var selection = try input("selection.xml");
    try selection.replace("1.0", "9.0");
    var path = try fixture.file("selection.xml");
    try checks.write(path, selection);
    var result = try generate(fixture);
    try std.test.assert_ne(result.status(), 0);
    try std.test.assert(result.stderr().contains("missing GIR dependency"));
  }
}
