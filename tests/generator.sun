using std;

/** Checks XML validation and GIR generation through the public command line. */
module generator_tests {

  /** Generates fixtures, preferring any locally modified input files. */
  function generate(fixture: ref checks.Fixture) std.process.Output throws {
    return checks.command(
      fixture,
      "selection=\"$4/tests/fixtures/selection.xml\"; if [ -f \"$1/selection.xml\" ]; then selection=\"$1/selection.xml\"; fi; exec \"$2/sun_gir\" --selection \"$selection\" --gir-dir \"$1\" --gir-dir \"$4/tests/fixtures\" --output-dir \"$1\" --target x86_64-linux-gnu --sun-revision fixture --generator-revision fixture"
    );
  }

  /** Reads an input fixture from the repository. */
  function input(name: static_ptr<u8>) String throws {
    var path = String(test_build.root());
    path.append("/tests/fixtures/");
    path.append(name);
    return checks.read(path);
  }

  /** Checks XML acceptance and numeric line and column diagnostics on rejection. */
  function xml(fixture: ref checks.Fixture, content: ref String, accepted: bool) void throws {
    var path = fixture.file("input.xml");
    checks.write(path, content);
    var output = checks.command(fixture, "exec \"$2/sun_gir\" --check-xml \"$1/input.xml\"");
    std.test.assert_eq(output.status() == 0, accepted);
    if (accepted == false) {
      var diagnostic: ref String = output.stderr();
      var start = match diagnostic.find("input.xml:") {
        Option.Some(index) => index,
        Option.None => -1
      };
      std.test.assert(start >= 0, "diagnostic includes the source filename");
      var offset = start + 10;
      for (var field: i32 = 0; field < 2; field += 1) {
        var digits: i64 = 0;
        while (offset < diagnostic.length()) {
          var byte = diagnostic.at(offset);
          if (byte < b'0' or byte > b'9') {
            break;
          }
          digits += 1;
          offset += 1;
        }
        std.test.assert(digits > 0, "diagnostic includes a numeric source location");
        std.test.assert_eq(diagnostic.at(offset), b':');
        offset += 1;
      }
    }
    return;
  }

  /** Accepts text, entity references, declarations, CDATA, and Unicode. */
  test_function valid_xml() {
    var fixture = checks.Fixture();
    var content = input("xml-valid.xml");
    xml(fixture, content, true);
    var unicode = String("<r a=\"&#x1F600;&#65;\">é &amp; <![CDATA[<>]]></r>");

    xml(fixture, unicode, true);
  }

  /** Rejects malformed structure, entities, encodings, and unsafe declarations. */
  test_function malformed_xml() {
    var fixture = checks.Fixture();
    var a = make_heap_allocator();
    var cases = Vec<String>(a, 16);
    cases.push(String("<r>"));
    cases.push(String("<r></wrong>"));

    cases.push(String("<r/><s/>"));
    cases.push(String("<r a=\"1\"a=\"2\"/>"));

    cases.push(String("<r a=\"1\" a=\"2\"/>"));

    cases.push(String("<r>&unknown;</r>"));

    cases.push(String("<r>&#0;</r>"));

    cases.push(String("<r>&#xD800;</r>"));

    cases.push(String("<r>&#99999999;</r>"));

    cases.push(
      String("<!DOCTYPE r SYSTEM \"file:///etc/passwd\"><r/>")
    );

    cases.push(String("<r><!-- bad -- comment --></r>"));

    cases.push(String("<r>]]></r>"));

    cases.push(String("<r a=\"<\"/>"));

    var overlong = String("<r>");
    overlong.append_char(192);
    overlong.append_char(128);
    overlong.append("</r>");
    cases.push(overlong);
    var truncated = String("<r>");
    truncated.append_char(240);
    truncated.append_char(144);
    truncated.append("</r>");
    cases.push(truncated);
    var nul = String("<r>");
    nul.append_char(0);
    nul.append("</r>");
    cases.push(nul);
    for (var content: ref String in cases) {
      xml(fixture, content, false);
    }
  }

  /** Verifies the source golden, compilation, metadata, hashes, and repeatability. */
  test_function generation() {
    var fixture = checks.Fixture();
    var result = generate(fixture);
    checks.success(result);
    var path = fixture.file("tiny.sun");
    var source = checks.read(path);
    var golden = input("tiny.expected.sun");
    std.test.assert_eq(source, golden);
    var compiled = checks.command(
      fixture,
      "\"$3\" --emit-moon -o \"$1/tiny.moon\" \"$1/tiny.sun\""
    );
    checks.success(compiled);
    var snapshot_allocator = make_heap_allocator();
    var entries = std.io.read_dir(snapshot_allocator, fixture.path);
    var contents = Vec<String>(snapshot_allocator, entries.size());
    for (var entry: ref std.io.DirEntry in entries) {
      var file_path = fixture.path.clone(snapshot_allocator);
      file_path.append("/");
      file_path.append(entry.name());
      contents.push(checks.read(file_path));
    }
    var again = generate(fixture);
    checks.success(again);
    var after = std.io.read_dir(snapshot_allocator, fixture.path);
    std.test.assert_eq(after.size(), entries.size());
    for (var i: i64 = 0; i < entries.size(); i += 1) {
      var file_path = fixture.path.clone(snapshot_allocator);
      file_path.append("/");
      file_path.append((entries.get(i)).name());
      var content = checks.read(file_path);
      std.test.assert_eq(contents.get(i), content);
    }
    var a = make_heap_allocator();
    var model_path = fixture.file("gir-model.json");
    var model = std.json.parse_json(a, checks.read(model_path));
    var nodes: ref std.json.Json = (model.at(0)).get("nodes");
    var parent_found = false;
    for (var i: i64 = 0; i < nodes.len(); i += 1) {
      var attrs: ref std.json.Json = (nodes.at(i)).get("attributes");
      if (attrs.has("parent")) {
        if (((attrs.get("parent")).as_string()).equals_literal("GObject.Object")) {
          parent_found = true;
        }
      }
    }
    std.test.assert(parent_found, "inheritance metadata retained");
    var provenance_path = fixture.file("provenance.json");
    var provenance = std.json.parse_json(a, checks.read(provenance_path));
    std.test.assert_eq(
      (((provenance.get("gir")).get("Tiny-1.0")).as_string()).length(),
      64
    );
    var coverage_path = fixture.file("coverage.tsv");
    var coverage = checks.read(coverage_path);
    std.test.assert(coverage.contains("tiny_unsupported\tunselected"));
  }

  /** Rejects unsupported selections before replacing previous generated sources. */
  test_function unsupported_selected_preserves_output() {
    var fixture = checks.Fixture();
    var result = generate(fixture);
    checks.success(result);
    var path = fixture.file("tiny.sun");
    var before = checks.read(path);
    var selection = input("selection.xml");
    selection.replace("tiny_increment", "tiny_unsupported");
    var selected = fixture.file("selection.xml");
    checks.write(selected, selection);
    var rejected = generate(fixture);
    std.test.assert_ne(rejected.status(), 0);
    std.test.assert(rejected.stderr().contains("unsupported selected type"));
    var after = checks.read(path);
    std.test.assert_eq(before, after);
  }

  /** Resolves dependency enum ABI and retains callback and ownership annotations. */
  test_function recursive_dependency() {
    var fixture = checks.Fixture();
    var source = input("Tiny-1.0.gir");
    source.replace(
      "<namespace name=\"Tiny\"",
      "<include name=\"TinyDep\" version=\"1.0\"/><namespace name=\"Tiny\""
    );
    source.replace(
      "name=\"gint\" c:type=\"gint\"",
      "name=\"TinyDep.Flags\" c:type=\"TinyFlags\""
    );
    source.replace(
      "name=\"value\" transfer-ownership=\"none\"",
      "name=\"value\" transfer-ownership=\"full\" nullable=\"1\" scope=\"notified\" closure=\"1\" destroy=\"2\""
    );
    var gir = fixture.file("Tiny-1.0.gir");
    checks.write(gir, source);
    var result = generate(fixture);
    checks.success(result);
    var path = fixture.file("tiny.sun");
    var generated = checks.read(path);
    std.test.assert(generated.contains("tiny_increment(arg0: u32) u32;"));
    var a = make_heap_allocator();
    var model_path = fixture.file("gir-model.json");
    var model = std.json.parse_json(a, checks.read(model_path));
    std.test.assert_eq(model.len(), 2);
    var nodes: ref std.json.Json = (model.at(0)).get("nodes");
    var found = false;
    for (var i: i64 = 0; i < nodes.len(); i += 1) {
      var node: ref std.json.Json = nodes.at(i);
      var parameter = false;
      if (true) {
        parameter = ((node.get("tag")).as_string()).equals_literal("parameter");
      }
      if (parameter and found == false) {
        var attrs: ref std.json.Json = node.get("attributes");
        std.test.assert(
          ((attrs.get("transfer-ownership")).as_string()).equals_literal("full")
        );
        std.test.assert(((attrs.get("nullable")).as_string()).equals_literal("1"));
        std.test.assert(((attrs.get("scope")).as_string()).equals_literal("notified"));
        std.test.assert(((attrs.get("closure")).as_string()).equals_literal("1"));
        std.test.assert(((attrs.get("destroy")).as_string()).equals_literal("2"));
        found = true;
      }
    }
    std.test.assert(found, "parameter metadata retained");
  }

  /** Resolves namespace URIs and rejects unbound or duplicate expanded names. */
  test_function namespace_prefixes() {
    var fixture = checks.Fixture();
    var unbound = String("<r><missing:child/></r>");
    xml(fixture, unbound, false);
    var duplicate = String("<r xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:x=\"1\" b:x=\"2\"/>");

    xml(fixture, duplicate, false);
    var bom = String("");
    bom.append_char(239);
    bom.append_char(187);
    bom.append_char(191);
    bom.append("<r>text\r\ntext</r>");
    xml(fixture, bom, true);
    var source = input("Tiny-1.0.gir");
    source.replace("xmlns:c=", "xmlns:native=");
    source.replace("c:", "native:");
    var gir = fixture.file("Tiny-1.0.gir");
    checks.write(gir, source);
    var result = generate(fixture);
    checks.success(result);
    var path = fixture.file("tiny.sun");
    var generated = checks.read(path);
    var golden = input("tiny.expected.sun");
    std.test.assert_eq(generated, golden);
  }

  /** Rejects a GIR file whose declared version differs from the requested name. */
  test_function dependency_version_mismatch() {
    var fixture = checks.Fixture();
    var source = input("Tiny-1.0.gir");
    source.replace("name=\"Tiny\" version=\"1.0\"", "name=\"Tiny\" version=\"2.0\"");
    var gir = fixture.file("Tiny-1.0.gir");
    checks.write(gir, source);
    var result = generate(fixture);
    std.test.assert_ne(result.status(), 0);
    std.test.assert(result.stderr().contains("namespace/version mismatch"));
  }

  /** Rejects a namespace version absent from the search paths. */
  test_function missing_dependency() {
    var fixture = checks.Fixture();
    var selection = input("selection.xml");
    selection.replace("1.0", "9.0");
    var path = fixture.file("selection.xml");
    checks.write(path, selection);
    var result = generate(fixture);
    std.test.assert_ne(result.status(), 0);
    std.test.assert(result.stderr().contains("missing GIR dependency"));
  }
}
