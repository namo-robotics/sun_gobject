using std;

/** Runs a GTK event loop using owned widgets and checked operations. */
module demo {

  /** Exercises a real button event and rejects invalid widget operations. */
  function check_widgets(window: ref gtk.Window, button: ref gtk.Button) SystemResult<void> {
    var original = try button.label();
    if (original.equals_literal("Click me") == false) {
      return SystemResult.Error(Error(1, "Initial button label differs"));
    }
    var invalid = try String("bad");
    try invalid.append_char(0);
    try invalid.append("label");
    match button.set_label(invalid) {
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Embedded NUL was accepted"));
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    var malformed = try String("");
    try malformed.append_char(192);
    try malformed.append_char(128);
    match button.set_label(malformed) {
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Invalid UTF-8 was accepted"));
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    match window.set_child(button) {
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Parented button was accepted"));
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    match window.set_default_size(0, 240) {
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Invalid size was accepted"));
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return SystemResult.Overflow(error);
      }
    };
    button.click();
    return SystemResult.Ok;
  }

  /** Owns widgets and callback state borrowed only while the event loop runs. */
  class AppState {
    var window: gtk.Window;
    var button: gtk.Button;
    var automated: bool;
    var clicked: bool = false;
    var closed: bool = false;

    /** Builds the window and button before transferring the application to the loop. */
    init(app: ref gtk.Application, automated: bool) SystemResult<void> {
      this.window = gtk.Window(app);
      var label = try String("Click me");
      this.button = try gtk.Button(label);
      this.automated = automated;
      var title = try String("Sun GObject");
      try this.window.set_title(title);
      try this.window.set_default_size(420, 240);
      try this.window.set_child(this.button);
      try this.window.present();
    }
  }

  /** Changes the label from a Sun callback after native dispatch has returned. */
  function clicked(
    state: ref AppState,
    context: ref gtk.EventContext<AppState>
  ) SystemResult<void> {
    var greeting = try String("Hello from Sun!");
    try state.button.set_label(greeting);
    state.clicked = true;
    if (state.automated) {
      var copied = try state.button.label();
      if (copied.equals(greeting) == false or state.button.take_click() == false or
        state.button.take_click()) {
        return SystemResult.Error(Error(1, "Button label or independent polling event differs"));
      }
      // Cancel this handler before closing, then emit a queued click that must be skipped.
      var own_id = context.registration();
      try context.disconnect(own_id);
      state.window.close();
      state.window.close();
      match state.window.present() {
        SystemResult.Ok => {
          return SystemResult.Error(Error(1, "Closed window was presented"));
        },
        SystemResult.Error(_) => {},
        SystemResult.Allocation(error) => {
          return SystemResult.Allocation(error);
        },
        SystemResult.InvalidArgument(error) => {
          return SystemResult.InvalidArgument(error);
        },
        SystemResult.Overflow(error) => {
          return SystemResult.Overflow(error);
        }
      };
      var detached = try String("Detached");
      try state.button.set_label(detached);
      state.button.click();
      if (state.button.take_click() == false or state.button.take_click()) {
        return SystemResult.Error(Error(1, "Detached button event differs"));
      }
    }
    return SystemResult.Ok;
  }

  /** Observes closure after GTK has removed the window from its application. */
  function closed(state: ref AppState, context: ref gtk.EventContext<AppState>) SystemResult<void> {
    state.closed = true;
    if (state.window.is_open()) {
      return SystemResult.Error(Error(1, "Close callback ran before window removal"));
    }
    return SystemResult.Ok;
  }

  /** Registers named callbacks and lends state to one safe dispatch session. */
  public function run(automated: bool) SystemResult<void> {
    var id = try String("org.sunlang.GObjectDemo");
    var app = try gtk.Application(id);
    var state = try AppState(app, automated);
    var loop = try gtk.EventLoop<AppState>(app);
    var click_id = try loop.on_clicked(state.button, clicked);
    var close_id = try loop.on_closed(state.window, closed);
    if (automated) {
      try check_widgets(state.window, state.button);
    }
    try loop.run(state);
    if (automated) {
      if (state.clicked == false or state.closed == false) {
        return SystemResult.Error(Error(1, "Missing GTK callback"));
      }
      std.io.println("GTK acceptance passed");
    }
    return SystemResult.Ok;
  }
}

/** Runs the interactive demo or its bounded safe-API acceptance scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) AllocationResult<i32> {
  var a = make_heap_allocator();
  var env = try std.env.Env(a);
  var args = try env.args(argc, argv);
  var automated = args.size() == 2 and args[1].equals_literal("--self-test");
  return AllocationResult.Ok(
    match demo.run(automated) {
      SystemResult.Ok => 0,
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_gobject.moon",
    "sun_gtk.moon"
  ]
}
