using std;

/** Runs a GTK event loop using owned widgets and checked operations. */
module demo {

  /** Exercises a real button event and rejects invalid widget operations. */
  function check_widgets(window: ref gtk.Window, button: ref gtk.Button) void throws {
    var original = button.label();
    if (original.equals_literal("Click me") == false) {
      throw Error(1, "Initial button label differs");
    }
    var invalid = String("bad");
    invalid.append_char(0);
    invalid.append("label");

    var operation_completed_5 = false;
    try {
      button.set_label(invalid);
      operation_completed_5 = true;
      throw Error(1, "Embedded NUL was accepted");
    } catch (error: std.Error) {
      if (operation_completed_5) {
        throw;
      }
    }

    var malformed = String("");
    malformed.append_char(192);
    malformed.append_char(128);

    var operation_completed_4 = false;
    try {
      button.set_label(malformed);
      operation_completed_4 = true;
      throw Error(1, "Invalid UTF-8 was accepted");
    } catch (error: std.Error) {
      if (operation_completed_4) {
        throw;
      }
    }

    var operation_completed_3 = false;
    try {
      window.set_child(button);
      operation_completed_3 = true;
      throw Error(1, "Parented button was accepted");
    } catch (error: std.Error) {
      if (operation_completed_3) {
        throw;
      }
    }

    var operation_completed_2 = false;
    try {
      window.set_default_size(0, 240);
      operation_completed_2 = true;
      throw Error(1, "Invalid size was accepted");
    } catch (error: std.Error) {
      if (operation_completed_2) {
        throw;
      }
    }

    button.click();
    return;
  }

  /** Owns widgets and callback state borrowed only while the event loop runs. */
  class AppState {
    var window: gtk.Window;
    var button: gtk.Button;
    var automated: bool;
    var clicked: bool = false;
    var closed: bool = false;

    /** Builds the window and button before transferring the application to the loop. */
    init(app: ref gtk.Application, automated: bool) throws {
      this.window = gtk.Window(app);
      var label = String("Click me");
      this.button = gtk.Button(label);
      this.automated = automated;
      var title = String("Sun GObject");
      this.window.set_title(title);
      this.window.set_default_size(420, 240);
      this.window.set_child(this.button);
      this.window.present();
    }
  }

  /** Changes the label from a Sun callback after native dispatch has returned. */
  function clicked(state: ref AppState, context: ref gtk.EventContext<AppState>) void throws {
    var greeting = String("Hello from Sun!");
    state.button.set_label(greeting);
    state.clicked = true;
    if (state.automated) {
      var copied = state.button.label();
      if (copied.equals(greeting) == false or state.button.take_click() == false or
        state.button.take_click()) {
        throw Error(1, "Button label or independent polling event differs");
      }
      // Cancel this handler before closing, then emit a queued click that must be skipped.
      var own_id = context.registration();
      context.disconnect(own_id);
      state.window.close();
      state.window.close();

      var operation_completed_1 = false;
      try {
        state.window.present();
        operation_completed_1 = true;
        throw Error(1, "Closed window was presented");
      } catch (error: std.Error) {
        if (operation_completed_1) {
          throw;
        }
      }

      var detached = String("Detached");
      state.button.set_label(detached);
      state.button.click();
      if (state.button.take_click() == false or state.button.take_click()) {
        throw Error(1, "Detached button event differs");
      }
    }
    return;
  }

  /** Observes closure after GTK has removed the window from its application. */
  function closed(state: ref AppState, context: ref gtk.EventContext<AppState>) void throws {
    state.closed = true;
    if (state.window.is_open()) {
      throw Error(1, "Close callback ran before window removal");
    }
    return;
  }

  /** Registers named callbacks and lends state to one safe dispatch session. */
  public function run(automated: bool) void throws {
    var id = String("org.sunlang.GObjectDemo");
    var app = gtk.Application(id);
    var state = AppState(app, automated);
    var loop = gtk.EventLoop<AppState>(app);
    var click_id = loop.on_clicked(state.button, clicked);
    var close_id = loop.on_closed(state.window, closed);
    if (automated) {
      check_widgets(state.window, state.button);
    }
    loop.run(state);
    if (automated) {
      if (state.clicked == false or state.closed == false) {
        throw Error(1, "Missing GTK callback");
      }
      std.io.println("GTK acceptance passed");
    }
    return;
  }
}

/** Runs the interactive demo or its bounded safe-API acceptance scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  var automated = args.size() == 2 and args[1].equals_literal("--self-test");
  try {
    demo.run(automated);
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_gobject.moon",
    "sun_gtk.moon"
  ]
}
